bindings/nodejs/dist/
bindings/csharp/dist/

# Local test outputs; reviewed evidence under docs/validation stays tracked.
/ctest.xml
/benchmarks/corpus.json
/benchmarks/streaming_corpus.json
npm-debug.log*

# Local credentials/configuration; sanitized examples may be committed.
.env
