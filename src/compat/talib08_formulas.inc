   else if( (int)optInTimePeriod < 1 || (int)optInTimePeriod > 100000 )
      return -1;
   if( (int)optInStdDevPeriod == TA_INTEGER_DEFAULT )
      optInStdDevPeriod = 10;
   else if( (int)optInStdDevPeriod < 2 || (int)optInStdDevPeriod > 100000 )
      return -1;
   return optInStdDevPeriod - 1 + (optInTimePeriod - 1) + TA_GLOBALS_UNSTABLE(TA_FUNC_UNST_RVI,Rvi,((optInTimePeriod > 1) ? 10 * optInTimePeriod : 0),((optInTimePeriod > 1) ? 19 * optInTimePeriod : 0));
}

static TA08_HD TA_RetCode TA_RVOL(Arena& arena,  int    startIdx,
                               int    endIdx,
                               const double inVolume[],
                               int optInTimePeriod,
                               int          *outBegIdx,
                               int          *outNBElement,
                               double        outReal[] )
{
   double periodTotal;
   double baseline;
   double todayVolume;
   double trailingVolume;
   int i;
   int outIdx;
   int trailingIdx;
   int lookbackTotal;
   int nullRun;
   int liveIn;
   if( (startIdx < 0) || (startIdx > TA_INDEX_MAX) )
      return TA_OUT_OF_RANGE_START_INDEX;
   if( (endIdx < 0) || (endIdx > TA_INDEX_MAX) || (endIdx < startIdx) )
      return TA_OUT_OF_RANGE_END_INDEX;
   if( (int)optInTimePeriod == TA_INTEGER_DEFAULT )
      optInTimePeriod = 20;
   else if( (int)optInTimePeriod < 1 || (int)optInTimePeriod > 100000 )
      return TA_BAD_PARAM;
   if( !inVolume )
      return TA_BAD_PARAM;
   if( !outBegIdx || !outNBElement )
      return TA_BAD_PARAM;
   if( !outReal )
      return TA_BAD_PARAM;
   lookbackTotal = (int)optInTimePeriod;
   if( startIdx < lookbackTotal )
   {
      startIdx = lookbackTotal;
   }
   if( startIdx > endIdx )
   {
      *outBegIdx= 0;
      *outNBElement= 0;
      return TA_SUCCESS;
   }
   periodTotal = 0.0;
   trailingIdx = startIdx - lookbackTotal;
   nullRun = 0;
   i = trailingIdx;
   while( i < startIdx )
   {
      periodTotal += (double)inVolume[i];
      liveIn = (fabs(inVolume[i]) <= 0.0) ? 0 : 1;
      nullRun = (nullRun + 1) & (liveIn - 1);
      i = i + 1;
   }
   outIdx = 0;
   while( i <= endIdx )
   {
      baseline = periodTotal / (double)optInTimePeriod;
      trailingVolume = (double)inVolume[trailingIdx];
      trailingIdx = trailingIdx + 1;
      todayVolume = (double)inVolume[i];
      i = i + 1;
      outReal[outIdx] = todayVolume / baseline;
      outIdx = outIdx + 1;
      periodTotal -= trailingVolume;
      periodTotal += todayVolume;
      liveIn = (fabs(todayVolume) <= 0.0) ? 0 : 1;
      nullRun = (nullRun + 1) & (liveIn - 1);
      if( TA_UNLIKELY(nullRun >= optInTimePeriod) )
      {
         periodTotal = 0.0;
      }
   }
   *outNBElement= outIdx;
   *outBegIdx= startIdx;
   return TA_SUCCESS;
}

static TA08_HD int TA_RVOL_Lookback(Arena& arena,  int optInTimePeriod )
{
   if( (int)optInTimePeriod == TA_INTEGER_DEFAULT )
      optInTimePeriod = 20;
   else if( (int)optInTimePeriod < 1 || (int)optInTimePeriod > 100000 )
      return -1;
   return optInTimePeriod;
}

static TA08_HD TA_RetCode TA_SI(Arena& arena,  int    startIdx,
                             int    endIdx,
                             const double inOpen[],
                             const double inHigh[],
                             const double inLow[],
                             const double inClose[],
                             double optInLimitMove,
                             int          *outBegIdx,
                             int          *outNBElement,
                             double        outReal[] )
{
   int i;
   int outIdx;
   int lookbackTotal;
   double prevClose;
   double prevBody;
   double tempOpen;
   double tempHigh;
   double tempLow;
   double tempClose;
   double body;
   double n;
   double up;
   double dn;
   double rg;
   double k;
   double r;
   double swing;
   if( (startIdx < 0) || (startIdx > TA_INDEX_MAX) )
      return TA_OUT_OF_RANGE_START_INDEX;
   if( (endIdx < 0) || (endIdx > TA_INDEX_MAX) || (endIdx < startIdx) )
      return TA_OUT_OF_RANGE_END_INDEX;
   if( optInLimitMove == TA_REAL_DEFAULT )
      optInLimitMove = 3;
   else if( !(optInLimitMove >= 1e-8 && optInLimitMove <= TA_REAL_MAX) )
      return TA_BAD_PARAM;
   if( !inOpen )
      return TA_BAD_PARAM;
   if( !inHigh )
      return TA_BAD_PARAM;
   if( !inLow )
      return TA_BAD_PARAM;
   if( !inClose )
      return TA_BAD_PARAM;
   if( !outBegIdx || !outNBElement )
      return TA_BAD_PARAM;
   if( !outReal )
      return TA_BAD_PARAM;
   lookbackTotal = TA_SI_Lookback(arena, optInLimitMove);
   if( startIdx < lookbackTotal )
   {
      startIdx = lookbackTotal;
   }
   if( startIdx > endIdx )
   {
      *outBegIdx= 0;
      *outNBElement= 0;
      return TA_SUCCESS;
   }
   prevClose = inClose[startIdx - 1];
   prevBody = prevClose - inOpen[startIdx - 1];
   outIdx = 0;
   for( i = startIdx; i <= endIdx; i += 1 )
   {
      tempOpen = inOpen[i];
      tempHigh = inHigh[i];
      tempLow = inLow[i];
      tempClose = inClose[i];
      body = tempClose - tempOpen;
      n = tempClose - prevClose;
      n += 0.5 * body;
      n += 0.25 * prevBody;
      up = fabs(tempHigh - prevClose);
      dn = fabs(tempLow - prevClose);
      rg = fabs(tempHigh - tempLow);
      k = max(up,dn);
      r = max(up - 0.5 * dn,dn - 0.5 * up);
      r = max(r,rg);
      r += 0.25 * fabs(prevBody);
      if( r == 0.0 )
      {
         swing = 0.0;
      } else
      {
         swing = 50.0 * (n / r) * (k / optInLimitMove);
      }
      outReal[outIdx] = swing;
      outIdx += 1;
      prevClose = tempClose;
      prevBody = body;
   }
   *outBegIdx= startIdx;
   *outNBElement= outIdx;
   return TA_SUCCESS;
}

static TA08_HD int TA_SI_Lookback(Arena& arena,  double optInLimitMove )
{
   if( optInLimitMove == TA_REAL_DEFAULT )
      optInLimitMove = 3;
   else if( !(optInLimitMove >= 1e-8 && optInLimitMove <= TA_REAL_MAX) )
      return -1;
   return 1;
}

static TA08_HD TA_RetCode TA_SMA(Arena& arena,  int    startIdx,
                              int    endIdx,
                              const double inReal[],
                              int optInTimePeriod,
                              int          *outBegIdx,
                              int          *outNBElement,
                              double        outReal[] )
{
   double periodTotal;
   double tempReal;
   int i;
   int outIdx;
   int trailingIdx;
   int lookbackTotal;
   if( (startIdx < 0) || (startIdx > TA_INDEX_MAX) )
      return TA_OUT_OF_RANGE_START_INDEX;
   if( (endIdx < 0) || (endIdx > TA_INDEX_MAX) || (endIdx < startIdx) )
      return TA_OUT_OF_RANGE_END_INDEX;
   if( (int)optInTimePeriod == TA_INTEGER_DEFAULT )
      optInTimePeriod = 30;
   else if( (int)optInTimePeriod < 1 || (int)optInTimePeriod > 100000 )
      return TA_BAD_PARAM;
   if( !inReal )
      return TA_BAD_PARAM;
   if( !outBegIdx || !outNBElement )
      return TA_BAD_PARAM;
   if( !outReal )
      return TA_BAD_PARAM;
   lookbackTotal = (int)(optInTimePeriod - 1);
   if( startIdx < lookbackTotal )
   {
      startIdx = lookbackTotal;
   }
   if( startIdx > endIdx )
   {
      *outBegIdx= 0;
      *outNBElement= 0;
      return TA_SUCCESS;
   }
   periodTotal = 0.0;
   trailingIdx = startIdx - lookbackTotal;
   i = trailingIdx;
   if( optInTimePeriod > 1 )
   {
      while( i < startIdx )
      {
         periodTotal += (double)inReal[i];
         i = i + 1;
      }
   }
   outIdx = 0;
   while( i <= endIdx )
   {
      periodTotal += (double)inReal[i];
      i = i + 1;
      tempReal = periodTotal;
      periodTotal -= (double)inReal[trailingIdx];
      trailingIdx = trailingIdx + 1;
      outReal[outIdx] = tempReal / (double)optInTimePeriod;
      outIdx = outIdx + 1;
   }
   *outNBElement= outIdx;
   *outBegIdx= startIdx;
   return TA_SUCCESS;
}

static TA08_HD int TA_SMA_Lookback(Arena& arena,  int optInTimePeriod )
{
   if( (int)optInTimePeriod == TA_INTEGER_DEFAULT )
      optInTimePeriod = 30;
   else if( (int)optInTimePeriod < 1 || (int)optInTimePeriod > 100000 )
      return -1;
   return optInTimePeriod - 1;
}

static TA08_HD TA_RetCode TA_SMI(Arena& arena,  int    startIdx,
                              int    endIdx,
                              const double inHigh[],
                              const double inLow[],
                              const double inClose[],
                              int optInTimePeriod,
                              int optInFastPeriod,
                              int optInSlowPeriod,
                              int optInSignalPeriod,
                              int          *outBegIdx,
                              int          *outNBElement,
                              double        outSMI[],
                              double        outSMISignal[] )
{
   double kSlow;
   double kFast;
   double kSignal;
   double betaSlow;
   double betaFast;
   double betaSignal;
   double highest;
   double lowest;
   double tmp;
   double emaSlowNum;
   double emaFastNum;
   double emaSlowDen;
   double emaFastDen;
   double sumSlowNum;
   double sumSlowDen;
   double sumFastNum;
   double sumFastDen;
   double sumSignal;
   double num;
   double den;
   double halfDen;
   double smiValue;
   double prevSignal;
   int lookbackTotal;
   int lookbackSlow;
   int lookbackFast;
   int today;
   int trailingIdx;
   int highestIdx;
   int lowestIdx;
   int i;
   int outIdx;
   int nBar;
   int nFast;
   int nSignal;
   if( (startIdx < 0) || (startIdx > TA_INDEX_MAX) )
      return TA_OUT_OF_RANGE_START_INDEX;
   if( (endIdx < 0) || (endIdx > TA_INDEX_MAX) || (endIdx < startIdx) )
      return TA_OUT_OF_RANGE_END_INDEX;
   if( (int)optInTimePeriod == TA_INTEGER_DEFAULT )
      optInTimePeriod = 13;
   else if( (int)optInTimePeriod < 2 || (int)optInTimePeriod > 100000 )
      return TA_BAD_PARAM;
   if( (int)optInFastPeriod == TA_INTEGER_DEFAULT )
      optInFastPeriod = 2;
   else if( (int)optInFastPeriod < 2 || (int)optInFastPeriod > 100000 )
      return TA_BAD_PARAM;
   if( (int)optInSlowPeriod == TA_INTEGER_DEFAULT )
      optInSlowPeriod = 25;
   else if( (int)optInSlowPeriod < 2 || (int)optInSlowPeriod > 100000 )
      return TA_BAD_PARAM;
   if( (int)optInSignalPeriod == TA_INTEGER_DEFAULT )
      optInSignalPeriod = 9;
   else if( (int)optInSignalPeriod < 2 || (int)optInSignalPeriod > 100000 )
      return TA_BAD_PARAM;
   if( !inHigh )
      return TA_BAD_PARAM;
   if( !inLow )
      return TA_BAD_PARAM;
   if( !inClose )
      return TA_BAD_PARAM;
   if( !outBegIdx || !outNBElement )
      return TA_BAD_PARAM;
   if( !outSMI )
      return TA_BAD_PARAM;
   if( !outSMISignal )
      return TA_BAD_PARAM;
   if( outSMI == outSMISignal )
      return TA_BAD_PARAM;
   lookbackTotal = TA_SMI_Lookback(arena, optInTimePeriod,optInFastPeriod,optInSlowPeriod,optInSignalPeriod);
   if( startIdx < lookbackTotal )
   {
      startIdx = lookbackTotal;
   }
   if( startIdx > endIdx )
   {
      *outBegIdx= 0;
      *outNBElement= 0;
      return TA_SUCCESS;
   }
   *outBegIdx= startIdx;
   betaSlow = (double)(optInSlowPeriod - 1) / (double)(optInSlowPeriod + 1);
   kSlow = 1.0 - betaSlow;
   if( betaSlow < 0.5 )
   {
      betaSlow = 1.0 - kSlow;
   }
   betaFast = (double)(optInFastPeriod - 1) / (double)(optInFastPeriod + 1);
   kFast = 1.0 - betaFast;
   if( betaFast < 0.5 )
   {
      betaFast = 1.0 - kFast;
   }
   betaSignal = (double)(optInSignalPeriod - 1) / (double)(optInSignalPeriod + 1);
   kSignal = 1.0 - betaSignal;
   if( betaSignal < 0.5 )
   {
      betaSignal = 1.0 - kSignal;
   }
   lookbackSlow = TA_EMA_Lookback(arena, optInSlowPeriod);
   lookbackFast = TA_EMA_Lookback(arena, optInFastPeriod);
   emaSlowNum = 0.0;
   emaSlowDen = 0.0;
   emaFastNum = 0.0;
   emaFastDen = 0.0;
   prevSignal = 0.0;
   smiValue = 0.0;
   sumSlowNum = 0.0;
   sumSlowDen = 0.0;
   sumFastNum = 0.0;
   sumFastDen = 0.0;
   sumSignal = 0.0;
   highest = 0.0;
   lowest = 0.0;
   highestIdx = -1;
   lowestIdx = -1;
   trailingIdx = startIdx - lookbackTotal;
   today = trailingIdx + (optInTimePeriod - 1);
   nBar = 0;
   while( today <= startIdx )
   {
      tmp = inLow[today];
      if( lowestIdx < trailingIdx )
      {
         lowestIdx = trailingIdx;
         lowest = inLow[lowestIdx];
         i = lowestIdx;
         while( ++i <= today )
         {
            tmp = inLow[i];
            if( tmp < lowest )
            {
               lowestIdx = i;
               lowest = tmp;
            }
         }
      } else if( tmp <= lowest )
      {
         lowestIdx = today;
         lowest = tmp;
      }
      tmp = inHigh[today];
      if( highestIdx < trailingIdx )
      {
         highestIdx = trailingIdx;
         highest = inHigh[highestIdx];
         i = highestIdx;
         while( ++i <= today )
         {
            tmp = inHigh[i];
            if( tmp > highest )
            {
               highestIdx = i;
               highest = tmp;
            }
         }
      } else if( tmp >= highest )
      {
         highestIdx = today;
         highest = tmp;
      }
      den = highest - lowest;
      num = inClose[today] - (highest + lowest) * 0.5;
      if( nBar < optInSlowPeriod )
      {
         sumSlowNum = sumSlowNum + num;
         sumSlowDen = sumSlowDen + den;
         if( nBar == optInSlowPeriod - 1 )
         {
            emaSlowNum = sumSlowNum / optInSlowPeriod;
            emaSlowDen = sumSlowDen / optInSlowPeriod;
         }
      } else
      {
         emaSlowNum = fma(betaSlow, emaSlowNum, kSlow * num);
         emaSlowDen = fma(betaSlow, emaSlowDen, kSlow * den);
      }
      if( nBar >= lookbackSlow )
      {
         nFast = nBar - lookbackSlow;
         if( nFast < optInFastPeriod )
         {
            sumFastNum = sumFastNum + emaSlowNum;
            sumFastDen = sumFastDen + emaSlowDen;
            if( nFast == optInFastPeriod - 1 )
            {
               emaFastNum = sumFastNum / optInFastPeriod;
               emaFastDen = sumFastDen / optInFastPeriod;
            }
         } else
         {
            emaFastNum = fma(betaFast, emaFastNum, kFast * emaSlowNum);
            emaFastDen = fma(betaFast, emaFastDen, kFast * emaSlowDen);
         }
      }
      if( nBar >= lookbackSlow + lookbackFast )
      {
         nSignal = nBar - lookbackSlow - lookbackFast;
         halfDen = 0.5 * emaFastDen;
         if( halfDen > 0.0 )
         {
            smiValue = 100.0 * emaFastNum / halfDen;
         } else
         {
            smiValue = 0.0;
         }
         if( nSignal < optInSignalPeriod )
         {
            sumSignal = sumSignal + smiValue;
            if( nSignal == optInSignalPeriod - 1 )
            {
               prevSignal = sumSignal / optInSignalPeriod;
            }
         } else
         {
            prevSignal = fma(betaSignal, prevSignal, kSignal * smiValue);
         }
      }
      nBar = nBar + 1;
      trailingIdx = trailingIdx + 1;
      today = today + 1;
   }
   outSMI[0] = smiValue;
   outSMISignal[0] = prevSignal;
   outIdx = 1;
   while( today <= endIdx )
   {
      tmp = inLow[today];
      if( lowestIdx < trailingIdx )
      {
         lowestIdx = trailingIdx;
         lowest = inLow[lowestIdx];
         i = lowestIdx;
         while( ++i <= today )
         {
            tmp = inLow[i];
            if( tmp < lowest )
            {
               lowestIdx = i;
               lowest = tmp;
            }
         }
      } else if( tmp <= lowest )
      {
         lowestIdx = today;
         lowest = tmp;
      }
      tmp = inHigh[today];
      if( highestIdx < trailingIdx )
      {
         highestIdx = trailingIdx;
         highest = inHigh[highestIdx];
         i = highestIdx;
         while( ++i <= today )
         {
            tmp = inHigh[i];
            if( tmp > highest )
            {
               highestIdx = i;
               highest = tmp;
            }
         }
      } else if( tmp >= highest )
      {
         highestIdx = today;
         highest = tmp;
      }
      den = highest - lowest;
      num = inClose[today] - (highest + lowest) * 0.5;
      emaSlowNum = fma(betaSlow, emaSlowNum, kSlow * num);
      emaSlowDen = fma(betaSlow, emaSlowDen, kSlow * den);
      emaFastNum = fma(betaFast, emaFastNum, kFast * emaSlowNum);
      emaFastDen = fma(betaFast, emaFastDen, kFast * emaSlowDen);
      halfDen = 0.5 * emaFastDen;
      if( halfDen > 0.0 )
      {
         smiValue = 100.0 * emaFastNum / halfDen;
      } else
      {
         smiValue = 0.0;
      }
      prevSignal = fma(betaSignal, prevSignal, kSignal * smiValue);
      outSMI[outIdx] = smiValue;
      outSMISignal[outIdx] = prevSignal;
      outIdx = outIdx + 1;
      trailingIdx = trailingIdx + 1;
      today = today + 1;
   }
   *outNBElement= outIdx;
   return TA_SUCCESS;
}

static TA08_HD int TA_SMI_Lookback(Arena& arena,  int optInTimePeriod, int optInFastPeriod, int optInSlowPeriod, int optInSignalPeriod )
{
   if( (int)optInTimePeriod == TA_INTEGER_DEFAULT )
      optInTimePeriod = 13;
   else if( (int)optInTimePeriod < 2 || (int)optInTimePeriod > 100000 )
      return -1;
   if( (int)optInFastPeriod == TA_INTEGER_DEFAULT )
      optInFastPeriod = 2;
   else if( (int)optInFastPeriod < 2 || (int)optInFastPeriod > 100000 )
      return -1;
   if( (int)optInSlowPeriod == TA_INTEGER_DEFAULT )
      optInSlowPeriod = 25;
   else if( (int)optInSlowPeriod < 2 || (int)optInSlowPeriod > 100000 )
      return -1;
   if( (int)optInSignalPeriod == TA_INTEGER_DEFAULT )
      optInSignalPeriod = 9;
   else if( (int)optInSignalPeriod < 2 || (int)optInSignalPeriod > 100000 )
      return -1;
   return optInTimePeriod - 1 + TA_EMA_Lookback(arena, optInSlowPeriod) + TA_EMA_Lookback(arena, optInFastPeriod) + TA_EMA_Lookback(arena, optInSignalPeriod);
}

static TA08_HD TA_RetCode TA_SQZMOM(Arena& arena,  int    startIdx,
                                 int    endIdx,
                                 const double inHigh[],
                                 const double inLow[],
                                 const double inClose[],
                                 int optInBBPeriod,
                                 double optInNbDev,
                                 int optInKCPeriod,
                                 double optInFactorWide,
                                 double optInFactorNormal,
                                 double optInFactorNarrow,
                                 int          *outBegIdx,
                                 int          *outNBElement,
                                 double        outMomentum[],
                                 int        outSqueeze[] )
{
   TA_RetCode retCode;
   int lookbackTotal;
   int stageLookback;
   int stageIdx;
   int stageLen;
   int i;
   int n;
   int tempBegIdx;
   int tempNbElement;
   int kcmNb;
   int sdNb;
   int kcmShift;
   double *tempDev;
   double *tempWork;
   double *tempKCM;
   double *tempMid;
   double *tempSD;
   double dev;
   double up;
   double lo;
   double centre;
   double band;
   if( (startIdx < 0) || (startIdx > TA_INDEX_MAX) )
      return TA_OUT_OF_RANGE_START_INDEX;
   if( (endIdx < 0) || (endIdx > TA_INDEX_MAX) || (endIdx < startIdx) )
      return TA_OUT_OF_RANGE_END_INDEX;
   if( (int)optInBBPeriod == TA_INTEGER_DEFAULT )
      optInBBPeriod = 20;
   else if( (int)optInBBPeriod < 2 || (int)optInBBPeriod > 100000 )
      return TA_BAD_PARAM;
   if( optInNbDev == TA_REAL_DEFAULT )
      optInNbDev = 2;
   else if( !(optInNbDev >= 0e0 && optInNbDev <= TA_REAL_MAX) )
      return TA_BAD_PARAM;
   if( (int)optInKCPeriod == TA_INTEGER_DEFAULT )
      optInKCPeriod = 20;
   else if( (int)optInKCPeriod < 2 || (int)optInKCPeriod > 100000 )
      return TA_BAD_PARAM;
   if( optInFactorWide == TA_REAL_DEFAULT )
      optInFactorWide = 2;
   else if( !(optInFactorWide >= 0e0 && optInFactorWide <= TA_REAL_MAX) )
      return TA_BAD_PARAM;
   if( optInFactorNormal == TA_REAL_DEFAULT )
      optInFactorNormal = 1.5;
   else if( !(optInFactorNormal >= 0e0 && optInFactorNormal <= TA_REAL_MAX) )
      return TA_BAD_PARAM;
   if( optInFactorNarrow == TA_REAL_DEFAULT )
      optInFactorNarrow = 1;
   else if( !(optInFactorNarrow >= 0e0 && optInFactorNarrow <= TA_REAL_MAX) )
      return TA_BAD_PARAM;
   if( !inHigh )
      return TA_BAD_PARAM;
   if( !inLow )
      return TA_BAD_PARAM;
   if( !inClose )
      return TA_BAD_PARAM;
   if( !outBegIdx || !outNBElement )
      return TA_BAD_PARAM;
   if( !outMomentum )
      return TA_BAD_PARAM;
   if( !outSqueeze )
      return TA_BAD_PARAM;
   if( (const void *)outMomentum == (const void *)outSqueeze )
      return TA_BAD_PARAM;
   if( optInFactorNormal > optInFactorWide || optInFactorNarrow > optInFactorNormal )
   {
      return TA_BAD_PARAM;
   }
   lookbackTotal = TA_SQZMOM_Lookback(arena, optInBBPeriod,optInNbDev,optInKCPeriod,optInFactorWide,optInFactorNormal,optInFactorNarrow);
   if( lookbackTotal > endIdx )
   {
      *outBegIdx= 0;
      *outNBElement= 0;
      return TA_SUCCESS;
   }
   if( startIdx < lookbackTotal )
   {
      startIdx = lookbackTotal;
   }
   if( startIdx > endIdx )
   {
      *outBegIdx= 0;
      *outNBElement= 0;
      return TA_SUCCESS;
   }
   n = endIdx - startIdx + 1;
   stageLookback = TA_LINEARREG_Lookback(arena, optInKCPeriod);
   stageIdx = startIdx - stageLookback;
   stageLen = n + stageLookback;
   tempDev = arena.allocate(stageLen * sizeof(double));
   if( !tempDev )
   {
      *outBegIdx= 0;
      *outNBElement= 0;
      return TA_ALLOC_ERR;
   }
   tempWork = arena.allocate(stageLen * sizeof(double));
   if( !tempWork )
   {
      arena.release(tempDev);
      *outBegIdx= 0;
      *outNBElement= 0;
      return TA_ALLOC_ERR;
   }
   tempKCM = arena.allocate(stageLen * sizeof(double));
   if( !tempKCM )
   {
      arena.release(tempDev);
      arena.release(tempWork);
      *outBegIdx= 0;
      *outNBElement= 0;
      return TA_ALLOC_ERR;
   }
   tempMid = arena.allocate(n * sizeof(double));
   if( !tempMid )
   {
      arena.release(tempDev);
      arena.release(tempWork);
      arena.release(tempKCM);
      *outBegIdx= 0;
      *outNBElement= 0;
      return TA_ALLOC_ERR;
   }
   tempSD = arena.allocate(n * sizeof(double));
   if( !tempSD )
   {
      arena.release(tempDev);
      arena.release(tempWork);
      arena.release(tempKCM);
      arena.release(tempMid);
      *outBegIdx= 0;
      *outNBElement= 0;
      return TA_ALLOC_ERR;
   }
   retCode = TA_MIDPRICE(arena, stageIdx,endIdx,inHigh,inLow,optInKCPeriod,outBegIdx,outNBElement,tempDev);
   if( retCode != TA_SUCCESS )
   {
      arena.release(tempDev);
      arena.release(tempWork);
      arena.release(tempKCM);
      arena.release(tempMid);
      arena.release(tempSD);
      *outBegIdx= 0;
      *outNBElement= 0;
      return retCode;
   }
   retCode = TA_SMA(arena, stageIdx,endIdx,inClose,optInKCPeriod,&tempBegIdx,&kcmNb,tempKCM);
   if( retCode != TA_SUCCESS )
   {
      arena.release(tempDev);
      arena.release(tempWork);
      arena.release(tempKCM);
      arena.release(tempMid);
      arena.release(tempSD);
      *outBegIdx= 0;
      *outNBElement= 0;
      return retCode;
   }
   for( i = 0; i < stageLen; i += 1 )
   {
      tempDev[i] = inClose[*outBegIdx + i] - (tempDev[i] + tempKCM[i]) / 2.0;
   }
   retCode = TA_TRANGE(arena, stageIdx,endIdx,inHigh,inLow,inClose,&tempBegIdx,&tempNbElement,tempWork);
   if( retCode != TA_SUCCESS )
   {
      arena.release(tempDev);
      arena.release(tempWork);
      arena.release(tempKCM);
      arena.release(tempMid);
      arena.release(tempSD);
      *outBegIdx= 0;
      *outNBElement= 0;
      return retCode;
   }
   retCode = TA_SMA(arena, 0,stageLen - 1,tempWork,optInKCPeriod,&tempBegIdx,&tempNbElement,tempWork);
   if( retCode != TA_SUCCESS )
   {
      arena.release(tempDev);
      arena.release(tempWork);
      arena.release(tempKCM);
      arena.release(tempMid);
      arena.release(tempSD);
      *outBegIdx= 0;
      *outNBElement= 0;
      return retCode;
   }
   retCode = TA_SMA(arena, startIdx,endIdx,inClose,optInBBPeriod,&tempBegIdx,&tempNbElement,tempMid);
   if( retCode != TA_SUCCESS )
   {
      arena.release(tempDev);
      arena.release(tempWork);
      arena.release(tempKCM);
      arena.release(tempMid);
      arena.release(tempSD);
      *outBegIdx= 0;
      *outNBElement= 0;
      return retCode;
   }
   retCode = TA_STDDEV(arena, startIdx,endIdx,inClose,optInBBPeriod,1.0,&tempBegIdx,&sdNb,tempSD);
   if( retCode != TA_SUCCESS )
   {
      arena.release(tempDev);
      arena.release(tempWork);
      arena.release(tempKCM);
      arena.release(tempMid);
      arena.release(tempSD);
      *outBegIdx= 0;
      *outNBElement= 0;
      return retCode;
   }
   kcmShift = kcmNb - sdNb;
   retCode = TA_LINEARREG(arena, 0,stageLen - 1,tempDev,optInKCPeriod,&tempBegIdx,&tempNbElement,outMomentum);
   if( retCode != TA_SUCCESS )
   {
      arena.release(tempDev);
      arena.release(tempWork);
      arena.release(tempKCM);
      arena.release(tempMid);
      arena.release(tempSD);
      *outBegIdx= 0;
      *outNBElement= 0;
      return retCode;
   }
   for( i = 0; i < n; i += 1 )
   {
      dev = tempSD[i] * optInNbDev;
      up = tempMid[i] + dev;
      lo = tempMid[i] - dev;
      centre = tempKCM[i + kcmShift];
      band = tempWork[i];
      if( lo > centre - optInFactorNarrow * band && up < centre + optInFactorNarrow * band )
      {
         outSqueeze[i] = 3;
      } else if( lo > centre - optInFactorNormal * band && up < centre + optInFactorNormal * band )
      {
         outSqueeze[i] = 2;
      } else if( lo > centre - optInFactorWide * band && up < centre + optInFactorWide * band )
      {
         outSqueeze[i] = 1;
      } else if( lo < centre - optInFactorWide * band && up > centre + optInFactorWide * band )
      {
         outSqueeze[i] = -1;
      } else
      {
         outSqueeze[i] = 0;
      }
   }
   arena.release(tempDev);
   arena.release(tempWork);
   arena.release(tempKCM);
   arena.release(tempMid);
   arena.release(tempSD);
   *outBegIdx= startIdx;
   *outNBElement= n;
   return TA_SUCCESS;
}

static TA08_HD int TA_SQZMOM_Lookback(Arena& arena,  int optInBBPeriod, double optInNbDev, int optInKCPeriod, double optInFactorWide, double optInFactorNormal, double optInFactorNarrow )
{
   int lookbackTotal;
   int leg;
   if( (int)optInBBPeriod == TA_INTEGER_DEFAULT )
      optInBBPeriod = 20;
   else if( (int)optInBBPeriod < 2 || (int)optInBBPeriod > 100000 )
      return -1;
   if( optInNbDev == TA_REAL_DEFAULT )
      optInNbDev = 2;
   else if( !(optInNbDev >= 0e0 && optInNbDev <= TA_REAL_MAX) )
      return -1;
   if( (int)optInKCPeriod == TA_INTEGER_DEFAULT )
      optInKCPeriod = 20;
   else if( (int)optInKCPeriod < 2 || (int)optInKCPeriod > 100000 )
      return -1;
   if( optInFactorWide == TA_REAL_DEFAULT )
      optInFactorWide = 2;
   else if( !(optInFactorWide >= 0e0 && optInFactorWide <= TA_REAL_MAX) )
      return -1;
   if( optInFactorNormal == TA_REAL_DEFAULT )
      optInFactorNormal = 1.5;
   else if( !(optInFactorNormal >= 0e0 && optInFactorNormal <= TA_REAL_MAX) )
      return -1;
   if( optInFactorNarrow == TA_REAL_DEFAULT )
      optInFactorNarrow = 1;
   else if( !(optInFactorNarrow >= 0e0 && optInFactorNarrow <= TA_REAL_MAX) )
      return -1;
   if( optInFactorNormal > optInFactorWide || optInFactorNarrow > optInFactorNormal )
   {
      return -1;
   }
   lookbackTotal = TA_SMA_Lookback(arena, optInBBPeriod);
   leg = TA_STDDEV_Lookback(arena, optInBBPeriod,1.0);
   if( leg > lookbackTotal )
   {
      lookbackTotal = leg;
   }
   leg = TA_TRANGE_Lookback(arena) + TA_SMA_Lookback(arena, optInKCPeriod);
   if( leg > lookbackTotal )
   {
      lookbackTotal = leg;
   }
   leg = TA_MIDPRICE_Lookback(arena, optInKCPeriod) + TA_LINEARREG_Lookback(arena, optInKCPeriod);
   if( leg > lookbackTotal )
   {
      lookbackTotal = leg;
   }
   return lookbackTotal;
}

static TA08_HD TA_RetCode TA_STC(Arena& arena,  int    startIdx,
                              int    endIdx,
                              const double inReal[],
                              int optInFastPeriod,
                              int optInSlowPeriod,
                              int optInCyclePeriod,
                              int          *outBegIdx,
                              int          *outNBElement,
                              double        outReal[] )
{
   double local_lineRing[30];
   double *lineRing = &local_lineRing[0];
   int lineRing_Idx;
   int maxIdx_lineRing;
   double local_lineSufHi[30];
   double *lineSufHi = &local_lineSufHi[0];
   double local_lineSufLo[30];
   double *lineSufLo = &local_lineSufLo[0];
   double local_pfRing[30];
   double *pfRing = &local_pfRing[0];
   int pfRing_Idx;
   int maxIdx_pfRing;
   double local_pfSufHi[30];
   double *pfSufHi = &local_pfSufHi[0];
   double local_pfSufLo[30];
   double *pfSufLo = &local_pfSufLo[0];
   double prevFast;
   double prevSlow;
   double fastK;
   double slowK;
   double tempReal;
   double lineValue;
   double fastBeta;
   double slowBeta;
   double lowest;
   double highest;
   double range;
   double frac1;
   double frac2;
   double pf;
   double pff;
   double lineHi;
   double lineLo;
   double pfHi;
   double pfLo;
   double sufHi;
   double sufLo;
   int i;
   int today;
   int fastToday;
   int lineStart;
   int outIdx;
   int tempInteger;
   int lookbackTotal;
   int lookbackSlow;
   int lastIdx;
   int nLine;
   int nPF;
   if( (startIdx < 0) || (startIdx > TA_INDEX_MAX) )
      return TA_OUT_OF_RANGE_START_INDEX;
   if( (endIdx < 0) || (endIdx > TA_INDEX_MAX) || (endIdx < startIdx) )
      return TA_OUT_OF_RANGE_END_INDEX;
   if( (int)optInFastPeriod == TA_INTEGER_DEFAULT )
      optInFastPeriod = 23;
   else if( (int)optInFastPeriod < 2 || (int)optInFastPeriod > 100000 )
      return TA_BAD_PARAM;
   if( (int)optInSlowPeriod == TA_INTEGER_DEFAULT )
      optInSlowPeriod = 50;
   else if( (int)optInSlowPeriod < 2 || (int)optInSlowPeriod > 100000 )
      return TA_BAD_PARAM;
   if( (int)optInCyclePeriod == TA_INTEGER_DEFAULT )
      optInCyclePeriod = 10;
   else if( (int)optInCyclePeriod < 2 || (int)optInCyclePeriod > 100000 )
      return TA_BAD_PARAM;
   if( !inReal )
      return TA_BAD_PARAM;
   if( !outBegIdx || !outNBElement )
      return TA_BAD_PARAM;
   if( !outReal )
      return TA_BAD_PARAM;
   if( optInSlowPeriod < optInFastPeriod )
   {
      tempInteger = optInSlowPeriod;
      optInSlowPeriod = optInFastPeriod;
      optInFastPeriod = tempInteger;
   }
   lookbackTotal = TA_STC_Lookback(arena, optInFastPeriod,optInSlowPeriod,optInCyclePeriod);
   if( startIdx < lookbackTotal )
   {
      startIdx = lookbackTotal;
   }
   if( startIdx > endIdx )
   {
      *outBegIdx= 0;
      *outNBElement= 0;
      return TA_SUCCESS;
   }
   *outBegIdx= startIdx;
   fastBeta = (double)(optInFastPeriod - 1) / (double)(optInFastPeriod + 1);
   fastK = 1.0 - fastBeta;
   if( fastBeta < 0.5 )
   {
      fastBeta = 1.0 - fastK;
   }
   slowBeta = (double)(optInSlowPeriod - 1) / (double)(optInSlowPeriod + 1);
   slowK = 1.0 - slowBeta;
   if( slowBeta < 0.5 )
   {
      slowBeta = 1.0 - slowK;
   }
   if( optInCyclePeriod < 1 ) return TA_INTERNAL_ERROR(462);
   if( (int)optInCyclePeriod > (int)(sizeof(local_lineRing)/sizeof(double)) )
   {
      lineRing = arena.allocate( sizeof(double)*optInCyclePeriod );
      if( !lineRing )
      {
         return TA_ALLOC_ERR;
      }
   }
   else
   {
      lineRing = &local_lineRing[0];
   }
   maxIdx_lineRing = (optInCyclePeriod-1);
   lineRing_Idx = 0;
   if( optInCyclePeriod < 1 ) return TA_INTERNAL_ERROR(463);
   if( (int)optInCyclePeriod > (int)(sizeof(local_lineSufHi)/sizeof(double)) )
   {
      lineSufHi = arena.allocate( sizeof(double)*optInCyclePeriod );
      if( !lineSufHi )
      {
         if( lineRing != &local_lineRing[0] ) arena.release( lineRing );
         return TA_ALLOC_ERR;
      }
   }
   else
   {
      lineSufHi = &local_lineSufHi[0];
   }
   if( optInCyclePeriod < 1 ) return TA_INTERNAL_ERROR(464);
   if( (int)optInCyclePeriod > (int)(sizeof(local_lineSufLo)/sizeof(double)) )
   {
      lineSufLo = arena.allocate( sizeof(double)*optInCyclePeriod );
      if( !lineSufLo )
      {
         if( lineRing != &local_lineRing[0] ) arena.release( lineRing );
         if( lineSufHi != &local_lineSufHi[0] ) arena.release( lineSufHi );
         return TA_ALLOC_ERR;
      }
   }
   else
   {
      lineSufLo = &local_lineSufLo[0];
   }
   if( optInCyclePeriod < 1 ) return TA_INTERNAL_ERROR(465);
   if( (int)optInCyclePeriod > (int)(sizeof(local_pfRing)/sizeof(double)) )
   {
      pfRing = arena.allocate( sizeof(double)*optInCyclePeriod );
      if( !pfRing )
      {
         if( lineRing != &local_lineRing[0] ) arena.release( lineRing );
         if( lineSufHi != &local_lineSufHi[0] ) arena.release( lineSufHi );
         if( lineSufLo != &local_lineSufLo[0] ) arena.release( lineSufLo );
         return TA_ALLOC_ERR;
      }
   }
   else
   {
      pfRing = &local_pfRing[0];
   }
   maxIdx_pfRing = (optInCyclePeriod-1);
   pfRing_Idx = 0;
   if( optInCyclePeriod < 1 ) return TA_INTERNAL_ERROR(466);
   if( (int)optInCyclePeriod > (int)(sizeof(local_pfSufHi)/sizeof(double)) )
   {
      pfSufHi = arena.allocate( sizeof(double)*optInCyclePeriod );
      if( !pfSufHi )
      {
         if( lineRing != &local_lineRing[0] ) arena.release( lineRing );
         if( lineSufHi != &local_lineSufHi[0] ) arena.release( lineSufHi );
         if( lineSufLo != &local_lineSufLo[0] ) arena.release( lineSufLo );
         if( pfRing != &local_pfRing[0] ) arena.release( pfRing );
         return TA_ALLOC_ERR;
      }
   }
   else
   {
      pfSufHi = &local_pfSufHi[0];
   }
   if( optInCyclePeriod < 1 ) return TA_INTERNAL_ERROR(467);
   if( (int)optInCyclePeriod > (int)(sizeof(local_pfSufLo)/sizeof(double)) )
   {
      pfSufLo = arena.allocate( sizeof(double)*optInCyclePeriod );
      if( !pfSufLo )
      {
         if( lineRing != &local_lineRing[0] ) arena.release( lineRing );
         if( lineSufHi != &local_lineSufHi[0] ) arena.release( lineSufHi );
         if( lineSufLo != &local_lineSufLo[0] ) arena.release( lineSufLo );
         if( pfRing != &local_pfRing[0] ) arena.release( pfRing );
         if( pfSufHi != &local_pfSufHi[0] ) arena.release( pfSufHi );
         return TA_ALLOC_ERR;
      }
   }
   else
   {
      pfSufLo = &local_pfSufLo[0];
   }
   lastIdx = optInCyclePeriod - 1;
   lookbackSlow = TA_EMA_Lookback(arena, optInSlowPeriod);
   lineStart = startIdx - (lookbackTotal - lookbackSlow);
   today = startIdx - lookbackTotal;
   tempReal = 0.0;
   i = optInSlowPeriod;
   while( i-- > 0 )
   {
      tempReal += inReal[today++];
   }
   prevSlow = tempReal / optInSlowPeriod;
   fastToday = startIdx - lookbackTotal + (lookbackSlow - TA_EMA_Lookback(arena, optInFastPeriod));
   prevFast = 0.0;
   i = optInFastPeriod;
   while( i-- > 0 )
   {
      prevFast += inReal[fastToday++];
   }
   prevFast = prevFast / optInFastPeriod;
   while( today < fastToday )
   {
      tempReal = inReal[today++];
      prevSlow = fma(slowBeta, prevSlow, slowK * tempReal);
   }
   while( today <= lineStart )
   {
      tempReal = inReal[today++];
      prevFast = fma(fastBeta, prevFast, fastK * tempReal);
      prevSlow = fma(slowBeta, prevSlow, slowK * tempReal);
   }
   frac1 = 0.0;
   frac2 = 0.0;
   pf = 0.0;
   pff = 0.0;
   pfHi = 0.0;
   pfLo = 0.0;
   nPF = 0;
   lineValue = prevFast - prevSlow;
   lineRing[lineRing_Idx] = lineValue;
   lineRing_Idx++;
   if( lineRing_Idx > maxIdx_lineRing ) lineRing_Idx = 0;
   lineHi = lineValue;
   lineLo = lineValue;
   nLine = 1;
   while( today <= startIdx )
   {
      tempReal = inReal[today];
      prevFast = fma(fastBeta, prevFast, fastK * tempReal);
      prevSlow = fma(slowBeta, prevSlow, slowK * tempReal);
      lineValue = prevFast - prevSlow;
      nLine = nLine + 1;
      lineRing[lineRing_Idx] = lineValue;
      if( lineRing_Idx == 0 )
      {
         lineHi = lineValue;
         lineLo = lineValue;
      } else
      {
         if( lineValue > lineHi )
         {
            lineHi = lineValue;
         }
         if( lineValue < lineLo )
         {
            lineLo = lineValue;
         }
      }
      highest = lineHi;
      lowest = lineLo;
      if( nLine >= optInCyclePeriod && lineRing_Idx < lastIdx )
      {
         tempReal = lineSufHi[lineRing_Idx + 1];
         if( tempReal > highest )
         {
            highest = tempReal;
         }
         tempReal = lineSufLo[lineRing_Idx + 1];
         if( tempReal < lowest )
         {
            lowest = tempReal;
         }
      }
      lineRing_Idx++;
      if( lineRing_Idx > maxIdx_lineRing ) lineRing_Idx = 0;
      if( lineRing_Idx == 0 )
      {
         sufHi = lineRing[lastIdx];
         sufLo = sufHi;
         lineSufHi[lastIdx] = sufHi;
         lineSufLo[lastIdx] = sufLo;
         i = lastIdx;
         while( i > 0 )
         {
            i -= 1;
            tempReal = lineRing[i];
            if( tempReal > sufHi )
            {
               sufHi = tempReal;
            }
            if( tempReal < sufLo )
            {
               sufLo = tempReal;
            }
            lineSufHi[i] = sufHi;
            lineSufLo[i] = sufLo;
         }
      }
      if( nLine >= optInCyclePeriod )
      {
         range = highest - lowest;
         if( range > 0.0 )
         {
            frac1 = (lineValue - lowest) / range * 100.0;
         }
         if( nPF == 0 )
         {
            pf = frac1;
         } else
         {
            pf = fma(0.5, frac1 - pf, pf);
         }
         nPF = nPF + 1;
         pfRing[pfRing_Idx] = pf;
         if( pfRing_Idx == 0 )
         {
            pfHi = pf;
            pfLo = pf;
         } else
         {
            if( pf > pfHi )
            {
               pfHi = pf;
            }
            if( pf < pfLo )
            {
               pfLo = pf;
            }
         }
         highest = pfHi;
         lowest = pfLo;
         if( nPF >= optInCyclePeriod && pfRing_Idx < lastIdx )
         {
            tempReal = pfSufHi[pfRing_Idx + 1];
            if( tempReal > highest )
            {
               highest = tempReal;
            }
            tempReal = pfSufLo[pfRing_Idx + 1];
            if( tempReal < lowest )
            {
               lowest = tempReal;
            }
         }
         pfRing_Idx++;
         if( pfRing_Idx > maxIdx_pfRing ) pfRing_Idx = 0;
         if( pfRing_Idx == 0 )
         {
            sufHi = pfRing[lastIdx];
            sufLo = sufHi;
            pfSufHi[lastIdx] = sufHi;
            pfSufLo[lastIdx] = sufLo;
            i = lastIdx;
            while( i > 0 )
            {
               i -= 1;
               tempReal = pfRing[i];
               if( tempReal > sufHi )
               {
                  sufHi = tempReal;
               }
               if( tempReal < sufLo )
               {
                  sufLo = tempReal;
               }
               pfSufHi[i] = sufHi;
               pfSufLo[i] = sufLo;
            }
         }
         if( nPF >= optInCyclePeriod )
         {
            range = highest - lowest;
            if( range > 0.0 )
            {
               frac2 = (pf - lowest) / range * 100.0;
            }
            if( nPF == optInCyclePeriod )
            {
               pff = frac2;
            } else
            {
               pff = fma(0.5, frac2 - pff, pff);
            }
         }
      }
      today = today + 1;
   }
   outReal[0] = pff;
   outIdx = 1;
   while( today <= endIdx )
   {
      tempReal = inReal[today];
      prevFast = fma(fastBeta, prevFast, fastK * tempReal);
      prevSlow = fma(slowBeta, prevSlow, slowK * tempReal);
      lineValue = prevFast - prevSlow;
      lineRing[lineRing_Idx] = lineValue;
      if( lineRing_Idx == 0 )
      {
         lineHi = lineValue;
         lineLo = lineValue;
      } else
      {
         if( lineValue > lineHi )
         {
            lineHi = lineValue;
         }
         if( lineValue < lineLo )
         {
            lineLo = lineValue;
         }
      }
      highest = lineHi;
      lowest = lineLo;
      if( lineRing_Idx < lastIdx )
      {
         tempReal = lineSufHi[lineRing_Idx + 1];
         if( tempReal > highest )
         {
            highest = tempReal;
         }
         tempReal = lineSufLo[lineRing_Idx + 1];
         if( tempReal < lowest )
         {
            lowest = tempReal;
         }
      }
      lineRing_Idx++;
      if( lineRing_Idx > maxIdx_lineRing ) lineRing_Idx = 0;
      if( lineRing_Idx == 0 )
      {
         sufHi = lineRing[lastIdx];
         sufLo = sufHi;
         lineSufHi[lastIdx] = sufHi;
         lineSufLo[lastIdx] = sufLo;
         i = lastIdx;
         while( i > 0 )
         {
            i -= 1;
            tempReal = lineRing[i];
            if( tempReal > sufHi )
            {
               sufHi = tempReal;
            }
            if( tempReal < sufLo )
            {
               sufLo = tempReal;
            }
            lineSufHi[i] = sufHi;
            lineSufLo[i] = sufLo;
         }
      }
      range = highest - lowest;
      if( range > 0.0 )
      {
         frac1 = (lineValue - lowest) / range * 100.0;
      }
      pf = fma(0.5, frac1 - pf, pf);
      pfRing[pfRing_Idx] = pf;
      if( pfRing_Idx == 0 )
      {
         pfHi = pf;
         pfLo = pf;
      } else
      {
         if( pf > pfHi )
         {
            pfHi = pf;
         }
         if( pf < pfLo )
         {
            pfLo = pf;
         }
      }
      highest = pfHi;
      lowest = pfLo;
      if( pfRing_Idx < lastIdx )
      {
         tempReal = pfSufHi[pfRing_Idx + 1];
         if( tempReal > highest )
         {
            highest = tempReal;
         }
         tempReal = pfSufLo[pfRing_Idx + 1];
         if( tempReal < lowest )
         {
            lowest = tempReal;
         }
      }
      pfRing_Idx++;
      if( pfRing_Idx > maxIdx_pfRing ) pfRing_Idx = 0;
      if( pfRing_Idx == 0 )
      {
         sufHi = pfRing[lastIdx];
         sufLo = sufHi;
         pfSufHi[lastIdx] = sufHi;
         pfSufLo[lastIdx] = sufLo;
         i = lastIdx;
         while( i > 0 )
         {
            i -= 1;
            tempReal = pfRing[i];
            if( tempReal > sufHi )
            {
               sufHi = tempReal;
            }
            if( tempReal < sufLo )
            {
               sufLo = tempReal;
            }
            pfSufHi[i] = sufHi;
            pfSufLo[i] = sufLo;
         }
      }
      range = highest - lowest;
      if( range > 0.0 )
      {
         frac2 = (pf - lowest) / range * 100.0;
      }
      pff = fma(0.5, frac2 - pff, pff);
      outReal[outIdx++] = pff;
      today = today + 1;
   }
   if( lineRing != &local_lineRing[0] ) { arena.release( lineRing ); lineRing = &local_lineRing[0]; }
   if( lineSufHi != &local_lineSufHi[0] ) { arena.release( lineSufHi ); lineSufHi = &local_lineSufHi[0]; }
   if( lineSufLo != &local_lineSufLo[0] ) { arena.release( lineSufLo ); lineSufLo = &local_lineSufLo[0]; }
