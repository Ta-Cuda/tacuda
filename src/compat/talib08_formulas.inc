   }
   if( startIdx > endIdx )
   {
      return TA_SUCCESS;
   }
   n = endIdx - startIdx + 1;
   tempT = arena.allocate(n * sizeof(double));
   if( !tempT )
   {
      return TA_ALLOC_ERR;
   }
   tempK = arena.allocate(n * sizeof(double));
   if( !tempK )
   {
      arena.release(tempT);
