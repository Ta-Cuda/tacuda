      den4 += 1;
      roc = (prior != 0.0) ? (inReal[inIdx] / prior - 1.0) * 100.0 : 0.0;
      total4 += roc;
      rcma4 = total4 / (double)optInSMA4Period;
      ring4[ring4_Idx] = roc;
      ring4_Idx++;
      if( ring4_Idx > maxIdx_ring4 ) ring4_Idx = 0;
      total4 -= ring4[ring4_Idx];
      kst = fma(4.0, rcma4, fma(3.0, rcma3, fma(2.0, rcma2, rcma1)));
      sigTotal += kst;
      sigRing[sigRing_Idx] = kst;
      sigRing_Idx++;
      if( sigRing_Idx > maxIdx_sigRing ) sigRing_Idx = 0;
      inIdx += 1;
   }
   outIdx = 0;
   while( inIdx <= endIdx )
   {
      prior = inReal[den1];
      den1 += 1;
      roc = (prior != 0.0) ? (inReal[inIdx] / prior - 1.0) * 100.0 : 0.0;
      total1 += roc;
      rcma1 = total1 / (double)optInSMA1Period;
      ring1[ring1_Idx] = roc;
      ring1_Idx++;
      if( ring1_Idx > maxIdx_ring1 ) ring1_Idx = 0;
      total1 -= ring1[ring1_Idx];
      prior = inReal[den2];
      den2 += 1;
      roc = (prior != 0.0) ? (inReal[inIdx] / prior - 1.0) * 100.0 : 0.0;
      total2 += roc;
      rcma2 = total2 / (double)optInSMA2Period;
      ring2[ring2_Idx] = roc;
      ring2_Idx++;
      if( ring2_Idx > maxIdx_ring2 ) ring2_Idx = 0;
      total2 -= ring2[ring2_Idx];
      prior = inReal[den3];
      den3 += 1;
      roc = (prior != 0.0) ? (inReal[inIdx] / prior - 1.0) * 100.0 : 0.0;
      total3 += roc;
      rcma3 = total3 / (double)optInSMA3Period;
      ring3[ring3_Idx] = roc;
      ring3_Idx++;
      if( ring3_Idx > maxIdx_ring3 ) ring3_Idx = 0;
      total3 -= ring3[ring3_Idx];
      prior = inReal[den4];
      den4 += 1;
      roc = (prior != 0.0) ? (inReal[inIdx] / prior - 1.0) * 100.0 : 0.0;
      total4 += roc;
      rcma4 = total4 / (double)optInSMA4Period;
      ring4[ring4_Idx] = roc;
      ring4_Idx++;
      if( ring4_Idx > maxIdx_ring4 ) ring4_Idx = 0;
      total4 -= ring4[ring4_Idx];
      kst = fma(4.0, rcma4, fma(3.0, rcma3, fma(2.0, rcma2, rcma1)));
      sigTotal += kst;
      sig = sigTotal / (double)optInSignalPeriod;
      sigRing[sigRing_Idx] = kst;
      sigRing_Idx++;
      if( sigRing_Idx > maxIdx_sigRing ) sigRing_Idx = 0;
      sigTotal -= sigRing[sigRing_Idx];
      outKST[outIdx] = kst;
      outKSTSignal[outIdx] = sig;
      outIdx += 1;
      inIdx += 1;
   }
   if( ring1 != &local_ring1[0] ) { arena.release( ring1 ); ring1 = &local_ring1[0]; }
   if( ring2 != &local_ring2[0] ) { arena.release( ring2 ); ring2 = &local_ring2[0]; }
   if( ring3 != &local_ring3[0] ) { arena.release( ring3 ); ring3 = &local_ring3[0]; }
   if( ring4 != &local_ring4[0] ) { arena.release( ring4 ); ring4 = &local_ring4[0]; }
   if( sigRing != &local_sigRing[0] ) { arena.release( sigRing ); sigRing = &local_sigRing[0]; }
   *outBegIdx= startIdx;
   *outNBElement= outIdx;
   return TA_SUCCESS;
}

static TA08_HD TA_RetCode TA_KSTEXT(Arena& arena,  int    startIdx,
                                 int    endIdx,
                                 const double inReal[],
                                 int optInROC1Period,
                                 int optInROC2Period,
                                 int optInROC3Period,
                                 int optInROC4Period,
                                 int optInMA1Period,
                                 int optInMA2Period,
                                 int optInMA3Period,
                                 int optInMA4Period,
                                 int optInSignalPeriod,
                                 int optInROCMAType,
                                 int optInSignalMAType,
                                 int          *outBegIdx,
                                 int          *outNBElement,
                                 double        outKST[],
                                 double        outKSTSignal[] )
{
   double *kstBuffer;
   double *tempBuffer;
   TA_RetCode retCode;
   int lookbackTotal;
   int lookbackSignal;
   int lookbackMA;
   int sigStart;
   int lookbackMA1;
   int lookbackMA2;
   int lookbackMA3;
   int lookbackMA4;
   int tempInteger;
   int tempBegIdx;
   int rocNb;
   int kstNb;
   int legNb;
   int sigNb;
   int i;
   if( (startIdx < 0) || (startIdx > TA_INDEX_MAX) )
      return TA_OUT_OF_RANGE_START_INDEX;
   if( (endIdx < 0) || (endIdx > TA_INDEX_MAX) || (endIdx < startIdx) )
      return TA_OUT_OF_RANGE_END_INDEX;
   if( (int)optInROC1Period == TA_INTEGER_DEFAULT )
      optInROC1Period = 10;
   else if( (int)optInROC1Period < 1 || (int)optInROC1Period > 100000 )
      return TA_BAD_PARAM;
   if( (int)optInROC2Period == TA_INTEGER_DEFAULT )
      optInROC2Period = 15;
   else if( (int)optInROC2Period < 1 || (int)optInROC2Period > 100000 )
      return TA_BAD_PARAM;
   if( (int)optInROC3Period == TA_INTEGER_DEFAULT )
      optInROC3Period = 20;
   else if( (int)optInROC3Period < 1 || (int)optInROC3Period > 100000 )
      return TA_BAD_PARAM;
   if( (int)optInROC4Period == TA_INTEGER_DEFAULT )
      optInROC4Period = 30;
   else if( (int)optInROC4Period < 1 || (int)optInROC4Period > 100000 )
      return TA_BAD_PARAM;
   if( (int)optInMA1Period == TA_INTEGER_DEFAULT )
      optInMA1Period = 10;
   else if( (int)optInMA1Period < 1 || (int)optInMA1Period > 100000 )
      return TA_BAD_PARAM;
   if( (int)optInMA2Period == TA_INTEGER_DEFAULT )
      optInMA2Period = 10;
   else if( (int)optInMA2Period < 1 || (int)optInMA2Period > 100000 )
      return TA_BAD_PARAM;
   if( (int)optInMA3Period == TA_INTEGER_DEFAULT )
      optInMA3Period = 10;
   else if( (int)optInMA3Period < 1 || (int)optInMA3Period > 100000 )
      return TA_BAD_PARAM;
   if( (int)optInMA4Period == TA_INTEGER_DEFAULT )
      optInMA4Period = 15;
   else if( (int)optInMA4Period < 1 || (int)optInMA4Period > 100000 )
      return TA_BAD_PARAM;
   if( (int)optInSignalPeriod == TA_INTEGER_DEFAULT )
      optInSignalPeriod = 9;
   else if( (int)optInSignalPeriod < 1 || (int)optInSignalPeriod > 100000 )
      return TA_BAD_PARAM;
   if( (int)optInROCMAType == TA_INTEGER_DEFAULT || optInROCMAType == TA_MAType_DEFAULT )
      optInROCMAType = 0;
   else if( (int)optInROCMAType < TA_MATYPE_MIN || (int)optInROCMAType > TA_MATYPE_MAX )
      return TA_BAD_PARAM;
   if( (int)optInSignalMAType == TA_INTEGER_DEFAULT || optInSignalMAType == TA_MAType_DEFAULT )
      optInSignalMAType = 0;
   else if( (int)optInSignalMAType < TA_MATYPE_MIN || (int)optInSignalMAType > TA_MATYPE_MAX )
      return TA_BAD_PARAM;
   if( !inReal )
      return TA_BAD_PARAM;
   if( !outBegIdx || !outNBElement )
      return TA_BAD_PARAM;
   if( !outKST )
      return TA_BAD_PARAM;
   if( !outKSTSignal )
      return TA_BAD_PARAM;
   if( outKST == outKSTSignal )
      return TA_BAD_PARAM;
   *outBegIdx= 0;
   *outNBElement= 0;
   lookbackSignal = TA_MA_Lookback(arena, optInSignalPeriod,optInSignalMAType);
   lookbackMA1 = TA_MA_Lookback(arena, optInMA1Period,optInROCMAType);
   lookbackMA2 = TA_MA_Lookback(arena, optInMA2Period,optInROCMAType);
   lookbackMA3 = TA_MA_Lookback(arena, optInMA3Period,optInROCMAType);
   lookbackMA4 = TA_MA_Lookback(arena, optInMA4Period,optInROCMAType);
   lookbackTotal = optInROC1Period + lookbackMA1;
   tempInteger = optInROC2Period + lookbackMA2;
   if( tempInteger > lookbackTotal )
   {
      lookbackTotal = tempInteger;
   }
   tempInteger = optInROC3Period + lookbackMA3;
   if( tempInteger > lookbackTotal )
   {
      lookbackTotal = tempInteger;
   }
   tempInteger = optInROC4Period + lookbackMA4;
   if( tempInteger > lookbackTotal )
   {
      lookbackTotal = tempInteger;
   }
   lookbackTotal += lookbackSignal;
   if( startIdx < lookbackTotal )
   {
      startIdx = lookbackTotal;
   }
   if( startIdx > endIdx )
   {
      return TA_SUCCESS;
   }
   sigStart = startIdx - lookbackSignal;
   lookbackMA = lookbackMA1;
   if( lookbackMA2 > lookbackMA )
   {
      lookbackMA = lookbackMA2;
   }
   if( lookbackMA3 > lookbackMA )
   {
      lookbackMA = lookbackMA3;
   }
   if( lookbackMA4 > lookbackMA )
   {
      lookbackMA = lookbackMA4;
   }
   tempInteger = endIdx - sigStart + 1 + lookbackMA;
   kstBuffer = arena.allocate(tempInteger * sizeof(double));
   if( !kstBuffer )
   {
      return TA_ALLOC_ERR;
   }
   tempBuffer = arena.allocate(tempInteger * sizeof(double));
   if( !tempBuffer )
   {
      arena.release(kstBuffer);
      return TA_ALLOC_ERR;
   }
   retCode = TA_ROC(arena, sigStart - lookbackMA1,endIdx,inReal,optInROC1Period,&tempBegIdx,&rocNb,kstBuffer);
   if( retCode != TA_SUCCESS )
   {
      arena.release(kstBuffer);
      arena.release(tempBuffer);
      return retCode;
   }
   retCode = TA_MA(arena, 0,rocNb - 1,kstBuffer,optInMA1Period,optInROCMAType,&tempBegIdx,&kstNb,kstBuffer);
   if( retCode != TA_SUCCESS )
   {
      arena.release(kstBuffer);
      arena.release(tempBuffer);
      return retCode;
   }
   retCode = TA_ROC(arena, sigStart - lookbackMA2,endIdx,inReal,optInROC2Period,&tempBegIdx,&rocNb,tempBuffer);
   if( retCode != TA_SUCCESS )
   {
      arena.release(kstBuffer);
      arena.release(tempBuffer);
      return retCode;
   }
   retCode = TA_MA(arena, 0,rocNb - 1,tempBuffer,optInMA2Period,optInROCMAType,&tempBegIdx,&legNb,tempBuffer);
   if( retCode != TA_SUCCESS )
   {
      arena.release(kstBuffer);
      arena.release(tempBuffer);
      return retCode;
   }
   for( i = 0; i < kstNb; i += 1 )
   {
      kstBuffer[i] = fma(2.0, tempBuffer[i], kstBuffer[i]);
   }
   retCode = TA_ROC(arena, sigStart - lookbackMA3,endIdx,inReal,optInROC3Period,&tempBegIdx,&rocNb,tempBuffer);
   if( retCode != TA_SUCCESS )
   {
      arena.release(kstBuffer);
      arena.release(tempBuffer);
      return retCode;
   }
   retCode = TA_MA(arena, 0,rocNb - 1,tempBuffer,optInMA3Period,optInROCMAType,&tempBegIdx,&legNb,tempBuffer);
   if( retCode != TA_SUCCESS )
   {
      arena.release(kstBuffer);
      arena.release(tempBuffer);
      return retCode;
   }
   for( i = 0; i < kstNb; i += 1 )
   {
      kstBuffer[i] = fma(3.0, tempBuffer[i], kstBuffer[i]);
   }
   retCode = TA_ROC(arena, sigStart - lookbackMA4,endIdx,inReal,optInROC4Period,&tempBegIdx,&rocNb,tempBuffer);
   if( retCode != TA_SUCCESS )
   {
      arena.release(kstBuffer);
      arena.release(tempBuffer);
      return retCode;
   }
   retCode = TA_MA(arena, 0,rocNb - 1,tempBuffer,optInMA4Period,optInROCMAType,&tempBegIdx,&legNb,tempBuffer);
   if( retCode != TA_SUCCESS )
   {
      arena.release(kstBuffer);
      arena.release(tempBuffer);
      return retCode;
   }
   for( i = 0; i < kstNb; i += 1 )
   {
      kstBuffer[i] = fma(4.0, tempBuffer[i], kstBuffer[i]);
   }
   memmove(outKST,&kstBuffer[lookbackSignal],(endIdx - startIdx + 1) * sizeof(double));
   retCode = TA_MA(arena, 0,kstNb - 1,kstBuffer,optInSignalPeriod,optInSignalMAType,&tempBegIdx,&sigNb,outKSTSignal);
   arena.release(kstBuffer);
   arena.release(tempBuffer);
   if( retCode != TA_SUCCESS )
   {
      return retCode;
   }
   *outBegIdx= startIdx;
   *outNBElement= sigNb;
   return TA_SUCCESS;
}

