static TA08_HD TA_RetCode TA_CVI(Arena& arena,  int    startIdx,
                              int    endIdx,
                              const double inHigh[],
                              const double inLow[],
                              int optInTimePeriod,
                              int optInROCPeriod,
                              int          *outBegIdx,
                              int          *outNBElement,
                              double        outReal[] )
{
   double prevEMA;
   double laggedEMA;
   double tempReal;
   double optInK_1;
   double emaBeta;
   int i;
   int today;
   int outIdx;
   int lookbackTotal;
   double local_emaRing[32];
   double *emaRing = &local_emaRing[0];
   int emaRing_Idx;
   int maxIdx_emaRing;
   if( (startIdx < 0) || (startIdx > TA_INDEX_MAX) )
      return TA_OUT_OF_RANGE_START_INDEX;
   if( (endIdx < 0) || (endIdx > TA_INDEX_MAX) || (endIdx < startIdx) )
      return TA_OUT_OF_RANGE_END_INDEX;
   if( (int)optInTimePeriod == TA_INTEGER_DEFAULT )
      optInTimePeriod = 10;
   else if( (int)optInTimePeriod < 2 || (int)optInTimePeriod > 100000 )
      return TA_BAD_PARAM;
   if( (int)optInROCPeriod == TA_INTEGER_DEFAULT )
      optInROCPeriod = 10;
   else if( (int)optInROCPeriod < 1 || (int)optInROCPeriod > 100000 )
      return TA_BAD_PARAM;
   if( !inHigh )
      return TA_BAD_PARAM;
   if( !inLow )
      return TA_BAD_PARAM;
   if( !outBegIdx || !outNBElement )
      return TA_BAD_PARAM;
   if( !outReal )
      return TA_BAD_PARAM;
   *outBegIdx= 0;
   *outNBElement= 0;
   lookbackTotal = TA_EMA_Lookback(arena, optInTimePeriod) + TA_ROCP_Lookback(arena, optInROCPeriod);
   if( startIdx < lookbackTotal )
   {
      startIdx = lookbackTotal;
   }
   if( startIdx > endIdx )
   {
      return TA_SUCCESS;
   }
   if( optInROCPeriod < 1 ) return TA_INTERNAL_ERROR(416);
   if( (int)optInROCPeriod > (int)(sizeof(local_emaRing)/sizeof(double)) )
   {
      emaRing = arena.allocate( sizeof(double)*optInROCPeriod );
      if( !emaRing )
      {
         return TA_ALLOC_ERR;
      }
   }
   else
   {
      emaRing = &local_emaRing[0];
   }
   maxIdx_emaRing = (optInROCPeriod-1);
   emaRing_Idx = 0;
   emaBeta = (double)(optInTimePeriod - 1) / (double)(optInTimePeriod + 1);
   optInK_1 = 1.0 - emaBeta;
   if( emaBeta < 0.5 )
   {
      emaBeta = 1.0 - optInK_1;
   }
   today = startIdx - lookbackTotal;
   i = optInTimePeriod;
   tempReal = 0.0;
   while( i-- > 0 )
   {
      tempReal += inHigh[today] - inLow[today];
      today += 1;
   }
   prevEMA = tempReal / optInTimePeriod;
   emaRing[emaRing_Idx] = prevEMA;
   emaRing_Idx++;
   if( emaRing_Idx > maxIdx_emaRing ) emaRing_Idx = 0;
   while( today < startIdx )
   {
      tempReal = inHigh[today] - inLow[today];
      prevEMA = fma(emaBeta, prevEMA, optInK_1 * tempReal);
      today += 1;
      emaRing[emaRing_Idx] = prevEMA;
      emaRing_Idx++;
      if( emaRing_Idx > maxIdx_emaRing ) emaRing_Idx = 0;
   }
   outIdx = 0;
   while( today <= endIdx )
   {
      tempReal = inHigh[today] - inLow[today];
      prevEMA = fma(emaBeta, prevEMA, optInK_1 * tempReal);
      today += 1;
      laggedEMA = emaRing[emaRing_Idx];
      emaRing[emaRing_Idx] = prevEMA;
      emaRing_Idx++;
      if( emaRing_Idx > maxIdx_emaRing ) emaRing_Idx = 0;
      if( laggedEMA != 0.0 )
      {
         outReal[outIdx++] = 100.0 * ((prevEMA - laggedEMA) / laggedEMA);
      } else
      {
         outReal[outIdx++] = 0.0;
      }
   }
   if( emaRing != &local_emaRing[0] ) { arena.release( emaRing ); emaRing = &local_emaRing[0]; }
   *outBegIdx= startIdx;
   *outNBElement= outIdx;
   return TA_SUCCESS;
}

