static TA08_HD TA_RetCode TA_ROGERSSATCHELL(Arena& arena,  int    startIdx,
                                         int    endIdx,
                                         const double inOpen[],
                                         const double inHigh[],
                                         const double inLow[],
                                         const double inClose[],
                                         int optInTimePeriod,
                                         double optInAnnualization,
                                         int          *outBegIdx,
                                         int          *outNBElement,
                                         double        outReal[] )
{
