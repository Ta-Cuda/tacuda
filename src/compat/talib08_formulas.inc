static TA08_HD TA_RetCode TA_WAVETREND(Arena& arena,  int    startIdx,
                                    int    endIdx,
                                    const double inHigh[],
                                    const double inLow[],
                                    const double inClose[],
                                    int optInChannelPeriod,
                                    int optInAveragePeriod,
                                    int optInSignalPeriod,
                                    int          *outBegIdx,
                                    int          *outNBElement,
                                    double        outWT1[],
                                    double        outWT2[] )
{
   double k1;
   double beta1;
   double k2;
   double beta2;
   double ap;
   double esa;
   double dev;
   double d;
   double ci;
   double wt1;
   double prevAp;
   double prevEsa;
   double num;
   double scaledDev;
   double sumEsa;
   double sumD;
   double sumCi;
   double sumSignal;
   int lookbackTotal;
   int lookbackChannel;
   int lookbackAverage;
   int today;
   int outIdx;
   int nAp;
   int nDev;
   int nCi;
   double local_wtBuffer[32];
   double *wtBuffer = &local_wtBuffer[0];
   int wtBuffer_Idx;
   int maxIdx_wtBuffer;
   if( (startIdx < 0) || (startIdx > TA_INDEX_MAX) )
      return TA_OUT_OF_RANGE_START_INDEX;
   if( (endIdx < 0) || (endIdx > TA_INDEX_MAX) || (endIdx < startIdx) )
      return TA_OUT_OF_RANGE_END_INDEX;
   if( (int)optInChannelPeriod == TA_INTEGER_DEFAULT )
      optInChannelPeriod = 10;
   else if( (int)optInChannelPeriod < 2 || (int)optInChannelPeriod > 100000 )
      return TA_BAD_PARAM;
   if( (int)optInAveragePeriod == TA_INTEGER_DEFAULT )
      optInAveragePeriod = 21;
   else if( (int)optInAveragePeriod < 1 || (int)optInAveragePeriod > 100000 )
      return TA_BAD_PARAM;
   if( (int)optInSignalPeriod == TA_INTEGER_DEFAULT )
      optInSignalPeriod = 4;
   else if( (int)optInSignalPeriod < 1 || (int)optInSignalPeriod > 100000 )
      return TA_BAD_PARAM;
   if( !inHigh )
      return TA_BAD_PARAM;
   if( !inLow )
      return TA_BAD_PARAM;
   if( !inClose )
      return TA_BAD_PARAM;
   if( !outBegIdx || !outNBElement )
      return TA_BAD_PARAM;
   if( !outWT1 )
      return TA_BAD_PARAM;
   if( !outWT2 )
      return TA_BAD_PARAM;
   if( outWT1 == outWT2 )
      return TA_BAD_PARAM;
   lookbackTotal = TA_WAVETREND_Lookback(arena, optInChannelPeriod,optInAveragePeriod,optInSignalPeriod);
   if( startIdx < lookbackTotal )
   {
      startIdx = lookbackTotal;
   }
   if( startIdx > endIdx )
   {
      *outBegIdx= 0;
      *outNBElement= 0;
      return TA_SUCCESS;
   }
   if( optInSignalPeriod < 1 ) return TA_INTERNAL_ERROR(497);
   if( (int)optInSignalPeriod > (int)(sizeof(local_wtBuffer)/sizeof(double)) )
   {
      wtBuffer = arena.allocate( sizeof(double)*optInSignalPeriod );
      if( !wtBuffer )
      {
         return TA_ALLOC_ERR;
      }
   }
   else
   {
      wtBuffer = &local_wtBuffer[0];
   }
   maxIdx_wtBuffer = (optInSignalPeriod-1);
   wtBuffer_Idx = 0;
   lookbackChannel = TA_EMA_Lookback(arena, optInChannelPeriod);
   lookbackAverage = TA_EMA_Lookback(arena, optInAveragePeriod);
   beta1 = (double)(optInChannelPeriod - 1) / (double)(optInChannelPeriod + 1);
   k1 = 1.0 - beta1;
   if( beta1 < 0.5 )
   {
      beta1 = 1.0 - k1;
   }
   beta2 = (double)(optInAveragePeriod - 1) / (double)(optInAveragePeriod + 1);
   k2 = 1.0 - beta2;
   if( beta2 < 0.5 )
   {
      beta2 = 1.0 - k2;
   }
   esa = 0.0;
   d = 0.0;
   ci = 0.0;
   wt1 = 0.0;
   sumEsa = 0.0;
   sumD = 0.0;
   sumCi = 0.0;
   sumSignal = 0.0;
   nAp = 0;
   prevAp = 0.0;
   prevEsa = 0.0;
   today = startIdx - lookbackTotal;
   while( today <= startIdx )
   {
      ap = (inHigh[today] + inLow[today] + inClose[today]) / 3.0;
      if( nAp < optInChannelPeriod )
      {
         sumEsa = sumEsa + ap;
         if( nAp == optInChannelPeriod - 1 )
         {
            esa = sumEsa / optInChannelPeriod;
         }
      } else
      {
         esa = fma(beta1, esa, k1 * ap);
      }
      if( nAp >= lookbackChannel )
      {
         nDev = nAp - lookbackChannel;
         num = ap - esa;
         if( nAp >= optInChannelPeriod && ap == prevAp && esa == prevEsa )
         {
            num = 0.0;
         }
         dev = fabs(num);
         if( nDev < optInChannelPeriod )
         {
            sumD = sumD + dev;
            if( nDev == optInChannelPeriod - 1 )
            {
               d = sumD / optInChannelPeriod;
            }
         } else
         {
            d = fma(beta1, d, k1 * dev);
         }
         if( nDev >= lookbackChannel )
         {
            nCi = nDev - lookbackChannel;
            scaledDev = 0.015 * d;
            if( scaledDev > 0.0 )
            {
               ci = num / scaledDev;
            } else
            {
               ci = 0.0;
            }
            if( nCi < optInAveragePeriod )
            {
               sumCi = sumCi + ci;
               if( nCi == optInAveragePeriod - 1 )
               {
                  wt1 = sumCi / optInAveragePeriod;
               }
            } else
            {
               wt1 = fma(beta2, wt1, k2 * ci);
            }
            if( nCi >= lookbackAverage )
            {
               wtBuffer[wtBuffer_Idx] = wt1;
               sumSignal = sumSignal + wt1;
               wtBuffer_Idx++;
               if( wtBuffer_Idx > maxIdx_wtBuffer ) wtBuffer_Idx = 0;
            }
         }
      }
      prevAp = ap;
      prevEsa = esa;
      nAp = nAp + 1;
      today = today + 1;
   }
   outWT1[0] = wt1;
   outWT2[0] = sumSignal / (double)optInSignalPeriod;
   outIdx = 1;
   sumSignal = sumSignal - wtBuffer[wtBuffer_Idx];
   while( today <= endIdx )
   {
      ap = (inHigh[today] + inLow[today] + inClose[today]) / 3.0;
      esa = fma(beta1, esa, k1 * ap);
      num = ap - esa;
      if( ap == prevAp && esa == prevEsa )
      {
         num = 0.0;
      }
      dev = fabs(num);
      d = fma(beta1, d, k1 * dev);
      scaledDev = 0.015 * d;
      if( scaledDev > 0.0 )
      {
         ci = num / scaledDev;
      } else
      {
         ci = 0.0;
      }
      wt1 = fma(beta2, wt1, k2 * ci);
      wtBuffer[wtBuffer_Idx] = wt1;
      sumSignal = sumSignal + wt1;
      outWT1[outIdx] = wt1;
      outWT2[outIdx] = sumSignal / (double)optInSignalPeriod;
      outIdx = outIdx + 1;
      wtBuffer_Idx++;
      if( wtBuffer_Idx > maxIdx_wtBuffer ) wtBuffer_Idx = 0;
      sumSignal = sumSignal - wtBuffer[wtBuffer_Idx];
      prevAp = ap;
      prevEsa = esa;
      today = today + 1;
   }
   if( wtBuffer != &local_wtBuffer[0] ) { arena.release( wtBuffer ); wtBuffer = &local_wtBuffer[0]; }
   *outNBElement= outIdx;
   *outBegIdx= startIdx;
   return TA_SUCCESS;
}

static TA08_HD int TA_WAVETREND_Lookback(Arena& arena,  int optInChannelPeriod, int optInAveragePeriod, int optInSignalPeriod )
{
   if( (int)optInChannelPeriod == TA_INTEGER_DEFAULT )
      optInChannelPeriod = 10;
   else if( (int)optInChannelPeriod < 2 || (int)optInChannelPeriod > 100000 )
      return -1;
   if( (int)optInAveragePeriod == TA_INTEGER_DEFAULT )
      optInAveragePeriod = 21;
   else if( (int)optInAveragePeriod < 1 || (int)optInAveragePeriod > 100000 )
      return -1;
   if( (int)optInSignalPeriod == TA_INTEGER_DEFAULT )
      optInSignalPeriod = 4;
   else if( (int)optInSignalPeriod < 1 || (int)optInSignalPeriod > 100000 )
      return -1;
   return TA_EMA_Lookback(arena, optInChannelPeriod) + TA_EMA_Lookback(arena, optInChannelPeriod) + TA_EMA_Lookback(arena, optInAveragePeriod) + TA_SMA_Lookback(arena, optInSignalPeriod);
}

static TA08_HD TA_RetCode TA_WMA(Arena& arena,  int    startIdx,
                              int    endIdx,
                              const double inReal[],
                              int optInTimePeriod,
                              int          *outBegIdx,
                              int          *outNBElement,
                              double        outReal[] )
{
   int inIdx;
   int outIdx;
   int i;
   int trailingIdx;
   int j;
   int rw;
   int lookbackWin;
   int barsSinceReseed;
   double periodSum;
   double periodSub;
   double tempReal;
   double trailingValue;
   double divider;
   int lookbackTotal;
   if( (startIdx < 0) || (startIdx > TA_INDEX_MAX) )
      return TA_OUT_OF_RANGE_START_INDEX;
   if( (endIdx < 0) || (endIdx > TA_INDEX_MAX) || (endIdx < startIdx) )
      return TA_OUT_OF_RANGE_END_INDEX;
   if( (int)optInTimePeriod == TA_INTEGER_DEFAULT )
      optInTimePeriod = 30;
   else if( (int)optInTimePeriod < 1 || (int)optInTimePeriod > 100000 )
      return TA_BAD_PARAM;
   if( !inReal )
      return TA_BAD_PARAM;
   if( !outBegIdx || !outNBElement )
      return TA_BAD_PARAM;
   if( !outReal )
      return TA_BAD_PARAM;
   lookbackTotal = optInTimePeriod - 1;
   if( startIdx < lookbackTotal )
   {
      startIdx = lookbackTotal;
   }
   if( startIdx > endIdx )
   {
      *outBegIdx= 0;
      *outNBElement= 0;
      return TA_SUCCESS;
   }
   if( optInTimePeriod == 1 )
   {
      *outBegIdx= startIdx;
      *outNBElement= endIdx - startIdx + 1;
      inIdx = startIdx;
      for( i = 0; i < (int)*outNBElement; i += 1 )
      {
         outReal[i] = inReal[inIdx++];
      }
      return TA_SUCCESS;
   }
   divider = (double)optInTimePeriod * (optInTimePeriod + 1) / 2.0;
   outIdx = 0;
   trailingIdx = startIdx - lookbackTotal;
   lookbackWin = optInTimePeriod - 1;
   periodSub = (double)0.0;
   periodSum = periodSub;
   inIdx = trailingIdx;
   i = 1;
   while( inIdx < startIdx )
   {
      tempReal = inReal[inIdx];
      inIdx += 1;
      periodSub += tempReal;
      periodSum += tempReal * i;
      i += 1;
   }
   barsSinceReseed = 8 * optInTimePeriod;
   trailingValue = 0.0;
   while( inIdx <= endIdx )
   {
      tempReal = inReal[inIdx];
      periodSub += tempReal;
      periodSub -= trailingValue;
      periodSum += tempReal * optInTimePeriod;
      barsSinceReseed -= 1;
      if( barsSinceReseed <= 0 )
      {
         barsSinceReseed = 8 * optInTimePeriod;
         periodSub = (double)0.0;
         periodSum = (double)0.0;
         rw = 1;
         for( j = inIdx - lookbackWin; j <= inIdx; j += 1 )
         {
            tempReal = inReal[j];
            periodSub += tempReal;
            periodSum += tempReal * rw;
            rw += 1;
         }
      }
      trailingValue = inReal[trailingIdx];
      trailingIdx += 1;
      outReal[outIdx++] = periodSum / divider;
      periodSum -= periodSub;
      inIdx += 1;
   }
   *outNBElement= outIdx;
   *outBegIdx= startIdx;
   return TA_SUCCESS;
}

static TA08_HD int TA_WMA_Lookback(Arena& arena,  int optInTimePeriod )
{
   if( (int)optInTimePeriod == TA_INTEGER_DEFAULT )
      optInTimePeriod = 30;
   else if( (int)optInTimePeriod < 1 || (int)optInTimePeriod > 100000 )
      return -1;
   return optInTimePeriod - 1;
}

static TA08_HD TA_RetCode TA_ZIGZAG(Arena& arena,  int    startIdx,
                                 int    endIdx,
                                 const double inHigh[],
                                 const double inLow[],
                                 double optInSensitivity,
                                 int optInMinTrendLength,
                                 int          *outBegIdx,
                                 int          *outNBElement,
                                 double        outZigZag[],
                                 int        outTrend[],
                                 int        outPivotIdx[] )
{
   int lookbackTotal;
   int today;
   int outIdx;
   int trend;
   int barsSincePivot;
   int barIdx;
   int isExt;
   double s;
   double up;
   double dn;
   double pivot;
   if( (startIdx < 0) || (startIdx > TA_INDEX_MAX) )
      return TA_OUT_OF_RANGE_START_INDEX;
   if( (endIdx < 0) || (endIdx > TA_INDEX_MAX) || (endIdx < startIdx) )
      return TA_OUT_OF_RANGE_END_INDEX;
   if( optInSensitivity == TA_REAL_DEFAULT )
      optInSensitivity = 5;
   else if( !(optInSensitivity >= 0e0 && optInSensitivity <= 1e2) )
      return TA_BAD_PARAM;
   if( (int)optInMinTrendLength == TA_INTEGER_DEFAULT )
      optInMinTrendLength = 1;
   else if( (int)optInMinTrendLength < 1 || (int)optInMinTrendLength > 100000 )
      return TA_BAD_PARAM;
   if( !inHigh )
      return TA_BAD_PARAM;
   if( !inLow )
      return TA_BAD_PARAM;
   if( !outBegIdx || !outNBElement )
      return TA_BAD_PARAM;
   if( !outZigZag )
      return TA_BAD_PARAM;
   if( !outTrend )
      return TA_BAD_PARAM;
   if( !outPivotIdx )
      return TA_BAD_PARAM;
   if( (const void *)outZigZag == (const void *)outTrend || (const void *)outZigZag == (const void *)outPivotIdx || outTrend == outPivotIdx )
      return TA_BAD_PARAM;
   lookbackTotal = TA_ZIGZAG_Lookback(arena, optInSensitivity,optInMinTrendLength);
   if( startIdx < lookbackTotal )
   {
      startIdx = lookbackTotal;
   }
   if( startIdx > endIdx )
   {
      *outBegIdx= 0;
      *outNBElement= 0;
      return TA_SUCCESS;
   }
   s = optInSensitivity / 100.0;
   up = 1.0 + s;
   dn = 1.0 - s;
   today = startIdx - lookbackTotal;
   trend = -1;
   pivot = inLow[today];
   barIdx = today;
   barsSincePivot = 0;
   today = today + 1;
   outIdx = 0;
   while( today <= endIdx )
   {
      barsSincePivot = barsSincePivot + 1;
      barIdx = barIdx + 1;
      if( trend == -1 )
      {
         if( inHigh[today] >= pivot * up && barsSincePivot >= optInMinTrendLength )
         {
            trend = 1;
            pivot = inHigh[today];
            barsSincePivot = 0;
         } else
         {
            isExt = (inLow[today] <= pivot) ? 1 : 0;
            pivot = TA_MIN_LT(pivot, inLow[today]);
            barsSincePivot = barsSincePivot - isExt * barsSincePivot;
         }
      } else if( inLow[today] <= pivot * dn && barsSincePivot >= optInMinTrendLength )
      {
         trend = -1;
         pivot = inLow[today];
         barsSincePivot = 0;
      } else
      {
         isExt = (inHigh[today] >= pivot) ? 1 : 0;
         pivot = TA_MAX_GT(pivot, inHigh[today]);
         barsSincePivot = barsSincePivot - isExt * barsSincePivot;
      }
      if( today >= startIdx )
      {
         outZigZag[outIdx] = pivot;
         outTrend[outIdx] = trend;
         outPivotIdx[outIdx] = barIdx - barsSincePivot;
         outIdx = outIdx + 1;
      }
      today = today + 1;
   }
   *outBegIdx= startIdx;
   *outNBElement= outIdx;
   return TA_SUCCESS;
}

static TA08_HD int TA_ZIGZAG_Lookback(Arena& arena,  double optInSensitivity, int optInMinTrendLength )
{
   if( optInSensitivity == TA_REAL_DEFAULT )
      optInSensitivity = 5;
   else if( !(optInSensitivity >= 0e0 && optInSensitivity <= 1e2) )
      return -1;
   if( (int)optInMinTrendLength == TA_INTEGER_DEFAULT )
      optInMinTrendLength = 1;
   else if( (int)optInMinTrendLength < 1 || (int)optInMinTrendLength > 100000 )
      return -1;
   return optInMinTrendLength;
}

static TA08_HD TA_RetCode TA_ZLEMA(Arena& arena,  int    startIdx,
                                int    endIdx,
                                const double inReal[],
                                int optInTimePeriod,
                                int          *outBegIdx,
                                int          *outNBElement,
                                double        outReal[] )
{
   double emaBeta;
   double optInK_1;
   double tempReal;
   double prevMA;
   int i;
   int today;
   int trailingIdx;
   int outIdx;
   int lag;
   int lookbackTotal;
   if( (startIdx < 0) || (startIdx > TA_INDEX_MAX) )
      return TA_OUT_OF_RANGE_START_INDEX;
   if( (endIdx < 0) || (endIdx > TA_INDEX_MAX) || (endIdx < startIdx) )
      return TA_OUT_OF_RANGE_END_INDEX;
   if( (int)optInTimePeriod == TA_INTEGER_DEFAULT )
      optInTimePeriod = 30;
   else if( (int)optInTimePeriod < 1 || (int)optInTimePeriod > 100000 )
      return TA_BAD_PARAM;
   if( !inReal )
      return TA_BAD_PARAM;
   if( !outBegIdx || !outNBElement )
      return TA_BAD_PARAM;
   if( !outReal )
      return TA_BAD_PARAM;
   emaBeta = (double)(optInTimePeriod - 1) / (double)(optInTimePeriod + 1);
   optInK_1 = 1.0 - emaBeta;
   if( emaBeta < 0.5 )
   {
      emaBeta = 1.0 - optInK_1;
   }
   lag = (optInTimePeriod - 1) / 2;
   lookbackTotal = TA_ZLEMA_Lookback(arena, optInTimePeriod);
   if( startIdx < lookbackTotal )
   {
      startIdx = lookbackTotal;
   }
   if( startIdx > endIdx )
   {
      *outBegIdx= 0;
      *outNBElement= 0;
      return TA_SUCCESS;
   }
   if( optInTimePeriod == 1 )
   {
      *outBegIdx= startIdx;
      outIdx = 0;
      today = startIdx;
      while( today <= endIdx )
      {
         outReal[outIdx++] = inReal[today++];
      }
      *outNBElement= outIdx;
      return TA_SUCCESS;
   }
   *outBegIdx= startIdx;
   trailingIdx = startIdx - lookbackTotal;
   today = trailingIdx + lag;
   i = optInTimePeriod;
   tempReal = 0.0;
   while( i-- > 0 )
   {
      tempReal += 2.0 * inReal[today] - inReal[trailingIdx];
      today += 1;
      trailingIdx += 1;
   }
   prevMA = tempReal / optInTimePeriod;
   while( today <= startIdx )
   {
      prevMA = fma(emaBeta, prevMA, optInK_1 * (2.0 * inReal[today] - inReal[trailingIdx]));
      today += 1;
      trailingIdx += 1;
   }
   outReal[0] = prevMA;
   outIdx = 1;
   while( today <= endIdx )
   {
      prevMA = fma(emaBeta, prevMA, optInK_1 * (2.0 * inReal[today] - inReal[trailingIdx]));
      today += 1;
      trailingIdx += 1;
      outReal[outIdx++] = prevMA;
   }
   *outNBElement= outIdx;
   return TA_SUCCESS;
}

static TA08_HD int TA_ZLEMA_Lookback(Arena& arena,  int optInTimePeriod )
{
   if( (int)optInTimePeriod == TA_INTEGER_DEFAULT )
      optInTimePeriod = 30;
   else if( (int)optInTimePeriod < 1 || (int)optInTimePeriod > 100000 )
      return -1;
   return (optInTimePeriod - 1) / 2 + TA_EMA_Lookback(arena, optInTimePeriod);
}
