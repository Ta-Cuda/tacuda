   if( !outReal )
      return TA_BAD_PARAM;
   outIdx = 0;
   for( i = startIdx; i <= endIdx; i += 1 )
   {
      if( inVolume[i] != 0.0 )
      {
         outReal[outIdx++] = (inHigh[i] - inLow[i]) / inVolume[i];
      } else
      {
         outReal[outIdx++] = 0.0;
      }
   }
   *outBegIdx= startIdx;
   *outNBElement= outIdx;
   return TA_SUCCESS;
}

