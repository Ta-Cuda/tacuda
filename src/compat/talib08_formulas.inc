   if( (endIdx < 0) || (endIdx > TA_INDEX_MAX) || (endIdx < startIdx) )
      return TA_OUT_OF_RANGE_END_INDEX;
   if( (int)optInTimePeriod == TA_INTEGER_DEFAULT )
      optInTimePeriod = 14;
   else if( (int)optInTimePeriod < 2 || (int)optInTimePeriod > 100000 )
      return TA_BAD_PARAM;
   if( !inReal )
      return TA_BAD_PARAM;
   if( !outBegIdx || !outNBElement )
      return TA_BAD_PARAM;
   if( !outReal )
      return TA_BAD_PARAM;
   *outBegIdx= 0;
   *outNBElement= 0;
   lookbackTotal = TA_CMOU_Lookback(arena, optInTimePeriod);
   if( startIdx < lookbackTotal )
   {
      startIdx = lookbackTotal;
   }
   if( startIdx > endIdx )
   {
      return TA_SUCCESS;
   }
   today = startIdx - lookbackTotal;
   trailingIdx = today + 1;
   prevValue = inReal[today];
   trailingValue = prevValue;
   upSum = 0.0;
   downSum = 0.0;
   nullRun = 0;
   for( i = 0; i < optInTimePeriod; i += 1 )
   {
      today += 1;
      tempReal = inReal[today];
      diff = tempReal - prevValue;
      prevValue = tempReal;
      up = (diff + fabs(diff)) * 0.5;
      upSum += up;
      downSum += up - diff;
      live = (fabs(diff) <= 0.0) ? 0 : 1;
      nullRun = (nullRun + 1) & (live - 1);
   }
   outIdx = 0;
   sum = upSum + downSum;
   if( sum > 0.0 )
   {
      outReal[outIdx++] = 100.0 * (upSum - downSum) / sum;
   } else
   {
      outReal[outIdx++] = 0.0;
   }
   tempReal = inReal[trailingIdx];
   diff = tempReal - trailingValue;
   trailingValue = tempReal;
   trailingIdx += 1;
   up = (diff + fabs(diff)) * 0.5;
   upSum -= up;
   downSum -= up - diff;
   today += 1;
   while( today <= endIdx )
   {
      tempReal = inReal[today];
      diff = tempReal - prevValue;
      prevValue = tempReal;
      up = (diff + fabs(diff)) * 0.5;
      upSum += up;
      downSum += up - diff;
      live = (fabs(diff) <= 0.0) ? 0 : 1;
      nullRun = (nullRun + 1) & (live - 1);
      if( TA_UNLIKELY(nullRun >= optInTimePeriod) )
      {
         nullRun = optInTimePeriod;
         upSum = 0.0;
         downSum = 0.0;
         outReal[outIdx++] = 0.0;
      } else
      {
         sum = upSum + downSum;
         if( sum > 0.0 )
         {
            outReal[outIdx++] = 100.0 * (upSum - downSum) / sum;
         } else
         {
            outReal[outIdx++] = 0.0;
         }
      }
      tempReal = inReal[trailingIdx];
      diff = tempReal - trailingValue;
      trailingValue = tempReal;
      trailingIdx += 1;
      up = (diff + fabs(diff)) * 0.5;
      upSum -= up;
      downSum -= up - diff;
      today += 1;
   }
   *outBegIdx= startIdx;
   *outNBElement= outIdx;
   return TA_SUCCESS;
}

static TA08_HD int TA_CMOU_Lookback(Arena& arena,  int optInTimePeriod )
{
   if( (int)optInTimePeriod == TA_INTEGER_DEFAULT )
      optInTimePeriod = 14;
   else if( (int)optInTimePeriod < 2 || (int)optInTimePeriod > 100000 )
      return -1;
   return optInTimePeriod;
}

static TA08_HD TA_RetCode TA_COPPOCK(Arena& arena,  int    startIdx,
                                  int    endIdx,
                                  const double inReal[],
                                  int optInWMAPeriod,
                                  int optInROC1Period,
                                  int optInROC2Period,
                                  int          *outBegIdx,
                                  int          *outNBElement,
                                  double        outReal[] )
{
   int outIdx;
   int inIdx;
   int lookbackTotal;
   int i;
   int q;
   int rw;
   int ringWalk;
   int ringSize;
   int barsSinceReseed;
   int roc1Idx;
   int roc2Idx;
   double periodSum;
   double periodSub;
   double tempReal;
   double tempReal2;
   double trailingValue;
   double divider;
   double base1;
   double base2;
   double roc1;
   double roc2;
   double local_sRing[50];
   double *sRing = &local_sRing[0];
   int sRing_Idx;
   int maxIdx_sRing;
   if( (startIdx < 0) || (startIdx > TA_INDEX_MAX) )
      return TA_OUT_OF_RANGE_START_INDEX;
   if( (endIdx < 0) || (endIdx > TA_INDEX_MAX) || (endIdx < startIdx) )
      return TA_OUT_OF_RANGE_END_INDEX;
   if( (int)optInWMAPeriod == TA_INTEGER_DEFAULT )
      optInWMAPeriod = 10;
   else if( (int)optInWMAPeriod < 1 || (int)optInWMAPeriod > 100000 )
      return TA_BAD_PARAM;
   if( (int)optInROC1Period == TA_INTEGER_DEFAULT )
      optInROC1Period = 11;
   else if( (int)optInROC1Period < 1 || (int)optInROC1Period > 100000 )
      return TA_BAD_PARAM;
   if( (int)optInROC2Period == TA_INTEGER_DEFAULT )
      optInROC2Period = 14;
   else if( (int)optInROC2Period < 1 || (int)optInROC2Period > 100000 )
      return TA_BAD_PARAM;
   if( !inReal )
      return TA_BAD_PARAM;
   if( !outBegIdx || !outNBElement )
      return TA_BAD_PARAM;
   if( !outReal )
      return TA_BAD_PARAM;
   lookbackTotal = TA_COPPOCK_Lookback(arena, optInWMAPeriod,optInROC1Period,optInROC2Period);
   if( startIdx < lookbackTotal )
   {
      startIdx = lookbackTotal;
   }
   if( startIdx > endIdx )
   {
      *outBegIdx= 0;
      *outNBElement= 0;
      return TA_SUCCESS;
   }
   divider = (double)optInWMAPeriod * (optInWMAPeriod + 1) / 2.0;
   outIdx = 0;
   ringSize = optInWMAPeriod - 1;
   if( ringSize < 1 )
   {
      ringSize = 1;
   }
   if( ringSize < 1 ) return TA_INTERNAL_ERROR(420);
   if( (int)ringSize > (int)(sizeof(local_sRing)/sizeof(double)) )
   {
      sRing = arena.allocate( sizeof(double)*ringSize );
      if( !sRing )
      {
         return TA_ALLOC_ERR;
      }
   }
   else
   {
      sRing = &local_sRing[0];
   }
   maxIdx_sRing = (ringSize-1);
   sRing_Idx = 0;
   sRing[0] = 0.0;
   inIdx = startIdx - (optInWMAPeriod - 1);
   roc1Idx = inIdx - optInROC1Period;
   roc2Idx = inIdx - optInROC2Period;
   periodSub = (double)0.0;
   periodSum = periodSub;
   i = 1;
   while( inIdx < startIdx )
   {
      base1 = inReal[roc1Idx];
      roc1Idx += 1;
      base2 = inReal[roc2Idx];
      roc2Idx += 1;
      roc1 = (base1 != 0.0) ? (inReal[inIdx] / base1 - 1.0) * 100.0 : 0.0;
      roc2 = (base2 != 0.0) ? (inReal[inIdx] / base2 - 1.0) * 100.0 : 0.0;
      tempReal = roc1 + roc2;
      periodSub += tempReal;
      periodSum += tempReal * i;
      i += 1;
      sRing[sRing_Idx] = tempReal;
      sRing_Idx++;
      if( sRing_Idx > maxIdx_sRing ) sRing_Idx = 0;
      inIdx += 1;
   }
   barsSinceReseed = 8 * optInWMAPeriod;
   trailingValue = 0.0;
   while( inIdx <= endIdx )
   {
      base1 = inReal[roc1Idx];
      roc1Idx += 1;
      base2 = inReal[roc2Idx];
      roc2Idx += 1;
      roc1 = (base1 != 0.0) ? (inReal[inIdx] / base1 - 1.0) * 100.0 : 0.0;
      roc2 = (base2 != 0.0) ? (inReal[inIdx] / base2 - 1.0) * 100.0 : 0.0;
      tempReal = roc1 + roc2;
      periodSub += tempReal;
      periodSub -= trailingValue;
      periodSum += tempReal * optInWMAPeriod;
      barsSinceReseed -= 1;
      if( barsSinceReseed <= 0 )
      {
         barsSinceReseed = 8 * optInWMAPeriod;
         periodSub = (double)0.0;
         periodSum = (double)0.0;
         rw = 1;
         ringWalk = sRing_Idx;
         for( q = 0; q < ringSize; q += 1 )
         {
            tempReal2 = sRing[ringWalk];
            periodSub += tempReal2;
            periodSum += tempReal2 * rw;
            rw += 1;
            ringWalk += 1;
            if( ringWalk >= ringSize )
            {
               ringWalk = 0;
            }
         }
         periodSub += tempReal;
         periodSum += tempReal * optInWMAPeriod;
      }
      trailingValue = sRing[sRing_Idx];
      sRing[sRing_Idx] = tempReal;
      sRing_Idx++;
      if( sRing_Idx > maxIdx_sRing ) sRing_Idx = 0;
      if( optInWMAPeriod == 1 )
      {
         outReal[outIdx] = tempReal;
      } else
      {
         outReal[outIdx] = periodSum / divider;
      }
      outIdx += 1;
      periodSum -= periodSub;
      inIdx += 1;
   }
   if( sRing != &local_sRing[0] ) { arena.release( sRing ); sRing = &local_sRing[0]; }
   *outBegIdx= startIdx;
   *outNBElement= outIdx;
   return TA_SUCCESS;
}

static TA08_HD int TA_COPPOCK_Lookback(Arena& arena,  int optInWMAPeriod, int optInROC1Period, int optInROC2Period )
{
   if( (int)optInWMAPeriod == TA_INTEGER_DEFAULT )
      optInWMAPeriod = 10;
   else if( (int)optInWMAPeriod < 1 || (int)optInWMAPeriod > 100000 )
      return -1;
   if( (int)optInROC1Period == TA_INTEGER_DEFAULT )
      optInROC1Period = 11;
   else if( (int)optInROC1Period < 1 || (int)optInROC1Period > 100000 )
      return -1;
   if( (int)optInROC2Period == TA_INTEGER_DEFAULT )
      optInROC2Period = 14;
   else if( (int)optInROC2Period < 1 || (int)optInROC2Period > 100000 )
      return -1;
   if( optInROC1Period > optInROC2Period )
   {
      return optInROC1Period + optInWMAPeriod - 1;
   }
   return optInROC2Period + optInWMAPeriod - 1;
}

static TA08_HD TA_RetCode TA_CRSI(Arena& arena,  int    startIdx,
                               int    endIdx,
                               const double inReal[],
                               int optInTimePeriod,
                               int optInStreakPeriod,
                               int optInRankPeriod,
                               int          *outBegIdx,
                               int          *outNBElement,
                               double        outReal[] )
{
   double *tempRSI;
   double *tempStreak;
   double *tempStreakRSI;
   TA_RetCode retCode;
   int lookbackTotal;
   int anchorIdx;
   int today;
   int outIdx;
   int i;
   int offsetRSI;
   int offsetStreak;
   int tempBegIdx;
   int rsiNb;
   int streakNb;
   int rocNb;
   double prevClose;
   double close;
   double streak;
   if( (startIdx < 0) || (startIdx > TA_INDEX_MAX) )
      return TA_OUT_OF_RANGE_START_INDEX;
   if( (endIdx < 0) || (endIdx > TA_INDEX_MAX) || (endIdx < startIdx) )
      return TA_OUT_OF_RANGE_END_INDEX;
   if( (int)optInTimePeriod == TA_INTEGER_DEFAULT )
      optInTimePeriod = 3;
   else if( (int)optInTimePeriod < 2 || (int)optInTimePeriod > 100000 )
      return TA_BAD_PARAM;
   if( (int)optInStreakPeriod == TA_INTEGER_DEFAULT )
      optInStreakPeriod = 2;
   else if( (int)optInStreakPeriod < 2 || (int)optInStreakPeriod > 100000 )
      return TA_BAD_PARAM;
   if( (int)optInRankPeriod == TA_INTEGER_DEFAULT )
      optInRankPeriod = 100;
   else if( (int)optInRankPeriod < 2 || (int)optInRankPeriod > 10000 )
      return TA_BAD_PARAM;
   if( !inReal )
      return TA_BAD_PARAM;
   if( !outBegIdx || !outNBElement )
      return TA_BAD_PARAM;
   if( !outReal )
      return TA_BAD_PARAM;
   *outBegIdx= 0;
   *outNBElement= 0;
   lookbackTotal = TA_CRSI_Lookback(arena, optInTimePeriod,optInStreakPeriod,optInRankPeriod);
   if( lookbackTotal > endIdx )
   {
      return TA_SUCCESS;
   }
   if( startIdx < lookbackTotal )
   {
      startIdx = lookbackTotal;
   }
   anchorIdx = startIdx - lookbackTotal;
   tempStreak = arena.allocate((endIdx - anchorIdx) * sizeof(double));
   if( !tempStreak )
   {
      return TA_ALLOC_ERR;
   }
   tempRSI = arena.allocate((endIdx - anchorIdx - TA_RSI_Lookback(arena, optInTimePeriod) + 1) * sizeof(double));
   if( !tempRSI )
   {
      arena.release(tempStreak);
      return TA_ALLOC_ERR;
   }
   tempStreakRSI = arena.allocate((endIdx - anchorIdx - TA_RSI_Lookback(arena, optInStreakPeriod)) * sizeof(double));
   if( !tempStreakRSI )
   {
      arena.release(tempStreak);
      arena.release(tempRSI);
      return TA_ALLOC_ERR;
   }
   streak = 0.0;
   prevClose = inReal[anchorIdx];
   outIdx = 0;
   today = anchorIdx + 1;
   while( today <= endIdx )
   {
      close = inReal[today];
      if( close > prevClose )
      {
         streak = (streak > 0.0) ? streak + 1.0 : 1.0;
      } else if( close < prevClose )
      {
         streak = (streak < 0.0) ? streak - 1.0 : -1.0;
      } else
      {
         streak = 0.0;
      }
      tempStreak[outIdx++] = streak;
      prevClose = close;
      today += 1;
   }
   retCode = TA_RSI(arena, 0,outIdx - 1,tempStreak,optInStreakPeriod,&tempBegIdx,&streakNb,tempStreakRSI);
   if( retCode != TA_SUCCESS )
   {
      arena.release(tempStreak);
      arena.release(tempRSI);
      arena.release(tempStreakRSI);
      return retCode;
   }
   retCode = TA_RSI(arena, anchorIdx + TA_RSI_Lookback(arena, optInTimePeriod),endIdx,inReal,optInTimePeriod,&tempBegIdx,&rsiNb,tempRSI);
   if( retCode != TA_SUCCESS )
   {
      arena.release(tempStreak);
      arena.release(tempRSI);
      arena.release(tempStreakRSI);
      return retCode;
   }
   retCode = TA_ROCP(arena, startIdx - optInRankPeriod,endIdx,inReal,1,&tempBegIdx,&rocNb,tempStreak);
   if( retCode != TA_SUCCESS )
   {
      arena.release(tempStreak);
      arena.release(tempRSI);
      arena.release(tempStreakRSI);
      return retCode;
   }
   retCode = TA_PERCENTRANK(arena, 0,rocNb - 1,tempStreak,optInRankPeriod,outBegIdx,outNBElement,outReal);
   if( retCode != TA_SUCCESS )
   {
      arena.release(tempStreak);
      arena.release(tempRSI);
      arena.release(tempStreakRSI);
      *outBegIdx= 0;
      *outNBElement= 0;
      return retCode;
   }
   offsetRSI = rsiNb - *outNBElement;
   offsetStreak = streakNb - *outNBElement;
   for( i = 0; i < (int)*outNBElement; i += 1 )
   {
      outReal[i] = (tempRSI[i + offsetRSI] + tempStreakRSI[i + offsetStreak] + outReal[i]) / 3.0;
   }
   arena.release(tempStreak);
   arena.release(tempRSI);
   arena.release(tempStreakRSI);
   *outBegIdx= startIdx;
   return TA_SUCCESS;
}

static TA08_HD int TA_CRSI_Lookback(Arena& arena,  int optInTimePeriod, int optInStreakPeriod, int optInRankPeriod )
{
   int retValue;
   if( (int)optInTimePeriod == TA_INTEGER_DEFAULT )
      optInTimePeriod = 3;
   else if( (int)optInTimePeriod < 2 || (int)optInTimePeriod > 100000 )
      return -1;
   if( (int)optInStreakPeriod == TA_INTEGER_DEFAULT )
      optInStreakPeriod = 2;
   else if( (int)optInStreakPeriod < 2 || (int)optInStreakPeriod > 100000 )
      return -1;
   if( (int)optInRankPeriod == TA_INTEGER_DEFAULT )
      optInRankPeriod = 100;
   else if( (int)optInRankPeriod < 2 || (int)optInRankPeriod > 10000 )
      return -1;
   retValue = TA_RSI_Lookback(arena, optInTimePeriod);
   retValue = max(retValue,TA_RSI_Lookback(arena, optInStreakPeriod) + 1);
   retValue = max(retValue,TA_PERCENTRANK_Lookback(arena, optInRankPeriod) + TA_ROCP_Lookback(arena, 1));
   return retValue;
}

static TA08_HD TA_RetCode TA_CTI(Arena& arena,  int    startIdx,
                              int    endIdx,
                              const double inReal[],
                              int optInTimePeriod,
                              int          *outBegIdx,
                              int          *outNBElement,
                              double        outReal[] )
{
   double sumX;
   double sumX2;
   double sumXY;
   double x;
   double trailingX;
   double peakX2;
   double shift;
   double ssX;
   double spXY;
   double tempReal;
   double invPeriod;
   double dPeriod;
   double sumY;
   double ssY;
   int lookbackTotal;
   int outIdx;
   int today;
   int trailingIdx;
   int windowStart;
   int j;
   int barsSinceReseed;
   if( (startIdx < 0) || (startIdx > TA_INDEX_MAX) )
      return TA_OUT_OF_RANGE_START_INDEX;
   if( (endIdx < 0) || (endIdx > TA_INDEX_MAX) || (endIdx < startIdx) )
      return TA_OUT_OF_RANGE_END_INDEX;
   if( (int)optInTimePeriod == TA_INTEGER_DEFAULT )
      optInTimePeriod = 20;
   else if( (int)optInTimePeriod < 2 || (int)optInTimePeriod > 100000 )
      return TA_BAD_PARAM;
   if( !inReal )
      return TA_BAD_PARAM;
   if( !outBegIdx || !outNBElement )
      return TA_BAD_PARAM;
   if( !outReal )
      return TA_BAD_PARAM;
   lookbackTotal = optInTimePeriod - 1;
   if( startIdx < lookbackTotal )
   {
      startIdx = lookbackTotal;
   }
   if( startIdx > endIdx )
   {
      *outBegIdx= 0;
      *outNBElement= 0;
      return TA_SUCCESS;
   }
   *outBegIdx= startIdx;
   trailingIdx = startIdx - lookbackTotal;
   dPeriod = (double)optInTimePeriod;
   invPeriod = 1.0 / dPeriod;
   sumY = dPeriod * (dPeriod - 1.0) * 0.5;
   ssY = dPeriod * (dPeriod * dPeriod - 1.0) / 12.0;
   shift = inReal[trailingIdx];
   sumXY = 0.0;
   sumX2 = sumXY;
   sumX = sumX2;
   for( j = trailingIdx; j < startIdx; j += 1 )
   {
      x = inReal[j] - shift;
      sumX += x;
      sumX2 += x * x;
      sumXY += x * (double)(startIdx - j);
   }
   today = startIdx;
   outIdx = 0;
   barsSinceReseed = 32 * optInTimePeriod;
   peakX2 = sumX2;
   do
   {
      x = inReal[today] - shift;
      sumX += x;
      sumX2 += x * x;
      peakX2 = (sumX2 > peakX2) ? sumX2 : peakX2;
      ssX = sumX2 - sumX * sumX * invPeriod;
      spXY = sumXY - sumX * sumY * invPeriod;
      barsSinceReseed -= 1;
      if( ssX < 0.000001 * peakX2 || barsSinceReseed <= 0 )
      {
         barsSinceReseed = 32 * optInTimePeriod;
         windowStart = today - lookbackTotal;
         tempReal = 0.0;
         for( j = windowStart; j <= today; j += 1 )
         {
            tempReal += inReal[j];
         }
         shift = tempReal * invPeriod;
         sumXY = 0.0;
         sumX2 = sumXY;
         sumX = sumX2;
         for( j = windowStart; j <= today; j += 1 )
         {
            x = inReal[j] - shift;
            sumX += x;
            sumX2 += x * x;
            sumXY += x * (double)(today - j);
         }
         if( sumX2 - sumX * sumX * invPeriod < 0.000001 * sumX2 )
         {
            shift = inReal[today];
            sumXY = 0.0;
            sumX2 = sumXY;
            sumX = sumX2;
            for( j = windowStart; j <= today; j += 1 )
            {
               x = inReal[j] - shift;
               sumX += x;
               sumX2 += x * x;
               sumXY += x * (double)(today - j);
            }
         }
         peakX2 = sumX2;
         ssX = sumX2 - sumX * sumX * invPeriod;
         spXY = sumXY - sumX * sumY * invPeriod;
      }
      trailingX = inReal[trailingIdx] - shift;
      trailingIdx += 1;
      if( ssX > 0.00000000000001 * sumX2 && ssX * ssY > 0.0 )
      {
         tempReal = -spXY / sqrt(ssX * ssY);
         if( tempReal > 1.0 )
         {
            tempReal = 1.0;
         } else if( tempReal < -1.0 )
         {
            tempReal = -1.0;
         }
         outReal[outIdx++] = tempReal;
      } else
      {
         outReal[outIdx++] = 0.0;
      }
      sumXY = sumXY + sumX - dPeriod * trailingX;
      sumX -= trailingX;
      sumX2 -= trailingX * trailingX;
      today += 1;
   } while( today <= endIdx );
   *outNBElement= outIdx;
   return TA_SUCCESS;
}

static TA08_HD int TA_CTI_Lookback(Arena& arena,  int optInTimePeriod )
{
   if( (int)optInTimePeriod == TA_INTEGER_DEFAULT )
      optInTimePeriod = 20;
   else if( (int)optInTimePeriod < 2 || (int)optInTimePeriod > 100000 )
      return -1;
   return optInTimePeriod - 1;
}

static TA08_HD TA_RetCode TA_CUMSUM(Arena& arena,  int    startIdx,
                                 int    endIdx,
                                 const double inReal[],
                                 int          *outBegIdx,
                                 int          *outNBElement,
                                 double        outReal[] )
{
   double total;
   int i;
   int outIdx;
   if( (startIdx < 0) || (startIdx > TA_INDEX_MAX) )
      return TA_OUT_OF_RANGE_START_INDEX;
   if( (endIdx < 0) || (endIdx > TA_INDEX_MAX) || (endIdx < startIdx) )
      return TA_OUT_OF_RANGE_END_INDEX;
   if( !inReal )
      return TA_BAD_PARAM;
   if( !outBegIdx || !outNBElement )
      return TA_BAD_PARAM;
   if( !outReal )
      return TA_BAD_PARAM;
   total = 0.0;
   for( i = startIdx, outIdx = 0; i <= endIdx; i += 1, outIdx += 1 )
   {
      total += inReal[i];
      outReal[outIdx] = total;
   }
   *outNBElement= outIdx;
   *outBegIdx= startIdx;
   return TA_SUCCESS;
}

