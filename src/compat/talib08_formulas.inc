                              int          *outNBElement,
                              double        outBullPower[],
                              double        outBearPower[] )
{
   int outIdx;
   int today;
   int lookbackTotal;
   int i;
   double prevMA;
   double tempReal;
   double k;
   double beta;
   double tempHT;
   double tempLT;
   if( (startIdx < 0) || (startIdx > TA_INDEX_MAX) )
      return TA_OUT_OF_RANGE_START_INDEX;
   if( (endIdx < 0) || (endIdx > TA_INDEX_MAX) || (endIdx < startIdx) )
      return TA_OUT_OF_RANGE_END_INDEX;
