      return TA_BAD_PARAM;
   if( !outBegIdx || !outNBElement )
      return TA_BAD_PARAM;
   if( !outReal )
      return TA_BAD_PARAM;
   if( TA_STDDEV_Lookback(arena, optInTimePeriod,optInNbDev) > endIdx )
   {
      *outBegIdx= 0;
      *outNBElement= 0;
      return TA_SUCCESS;
   }
   retCode = TA_VAR(arena, startIdx,endIdx,inReal,optInTimePeriod,1.0,outBegIdx,outNBElement,outReal);
   if( retCode != TA_SUCCESS )
   {
      return retCode;
   }
   if( optInNbDev != 1.0 )
   {
      for( i = 0; i < (int)*outNBElement; i += 1 )
      {
         outReal[i] = sqrt(outReal[i]) * optInNbDev;
      }
   } else
   {
      for( i = 0; i < (int)*outNBElement; i += 1 )
      {
         outReal[i] = sqrt(outReal[i]);
      }
   }
   return TA_SUCCESS;
}

