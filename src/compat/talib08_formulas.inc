   }
   return TA_EMA_Lookback(arena, optInSlowPeriod) + 2 * (optInCyclePeriod - 1) + TA_GLOBALS_UNSTABLE(TA_FUNC_UNST_STC,Stc,(5 * 10 + 1) / 2 + 3 * (optInSlowPeriod + 1),(5 * 19 + 1) / 2 + 3 * (optInSlowPeriod + 1));
}

static TA08_HD TA_RetCode TA_STDDEV(Arena& arena,  int    startIdx,
                                 int    endIdx,
                                 const double inReal[],
                                 int optInTimePeriod,
                                 double optInNbDev,
                                 int          *outBegIdx,
                                 int          *outNBElement,
                                 double        outReal[] )
{
   int i;
   TA_RetCode retCode;
   if( (startIdx < 0) || (startIdx > TA_INDEX_MAX) )
      return TA_OUT_OF_RANGE_START_INDEX;
   if( (endIdx < 0) || (endIdx > TA_INDEX_MAX) || (endIdx < startIdx) )
      return TA_OUT_OF_RANGE_END_INDEX;
