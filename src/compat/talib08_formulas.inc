      startIdx = lookbackTotal;
   }
   if( startIdx > endIdx )
   {
      *outBegIdx= 0;
      *outNBElement= 0;
      return TA_SUCCESS;
   }
   if( optInTimePeriod == 1 )
   {
      outIdx = 0;
      today = startIdx;
      while( today <= endIdx )
      {
         tempHT = inHigh[today];
         tempLT = inLow[today];
         tempReal = inClose[today];
         outBullPower[outIdx] = tempHT - tempReal;
         outBearPower[outIdx] = tempLT - tempReal;
         outIdx += 1;
         today += 1;
      }
      *outBegIdx= startIdx;
      *outNBElement= outIdx;
      return TA_SUCCESS;
   }
   beta = (double)(optInTimePeriod - 1) / (double)(optInTimePeriod + 1);
   k = 1.0 - beta;
   if( beta < 0.5 )
   {
      beta = 1.0 - k;
   }
   today = startIdx - lookbackTotal;
   i = optInTimePeriod;
   tempReal = 0.0;
   while( i-- > 0 )
   {
      tempReal += inClose[today++];
   }
   prevMA = tempReal / optInTimePeriod;
   while( today <= startIdx )
   {
      prevMA = fma(beta, prevMA, k * inClose[today++]);
   }
   tempHT = inHigh[startIdx];
   tempLT = inLow[startIdx];
   outBullPower[0] = tempHT - prevMA;
   outBearPower[0] = tempLT - prevMA;
   outIdx = 1;
   while( today <= endIdx )
   {
      prevMA = fma(beta, prevMA, k * inClose[today]);
      tempHT = inHigh[today];
      tempLT = inLow[today];
      outBullPower[outIdx] = tempHT - prevMA;
      outBearPower[outIdx] = tempLT - prevMA;
      outIdx += 1;
      today += 1;
   }
   *outBegIdx= startIdx;
   *outNBElement= outIdx;
   return TA_SUCCESS;
}

